<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="StartMenu.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="backdrop" class="backdrop" />
        <ui:VisualElement name="menu-content" class="menu-content">
            <ui:VisualElement name="home-stack" class="home-stack">
                <ui:VisualElement class="brand-row">
                    <ui:VisualElement class="brand-text">
                        <ui:Label name="title-ja" text="消しピンウォーズ" class="title-ja" />
                        <ui:Label name="title-en" text="ERASER WARS" class="title-en" />
                    </ui:VisualElement>
                    <ui:VisualElement name="brand-icon" class="brand-icon" />
                </ui:VisualElement>
                <ui:VisualElement class="spacer" />
                <ui:VisualElement class="action-stack">
                    <ui:VisualElement class="mode-segment">
                        <ui:Button name="mode-2p" text="2人対戦" class="mode-chip selected" />
                        <ui:Button name="mode-4p" text="4人対戦" class="mode-chip" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mode-segment">
                        <ui:Button name="mode-stock" text="ストック戦" class="mode-chip selected" />
                        <ui:Button name="mode-points" text="ポイント戦" class="mode-chip" />
                    </ui:VisualElement>
                    <ui:VisualElement name="seat-strip" class="seat-strip" />
                    <ui:VisualElement name="seat-picker" class="seat-picker hidden">
                        <ui:Label name="seat-picker-caption" text="" class="seat-picker-caption" />
                        <ui:ScrollView name="seat-picker-scroll" class="seat-picker-scroll" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden">
                            <ui:VisualElement name="seat-picker-row" class="seat-picker-row" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement name="home-tip" class="home-tip">
                        <ui:Label name="home-tip-copy" text="カードを1枚出して、ドラッグではじく。" class="home-tip-copy" />
                        <ui:Button name="home-tip-dismiss" text="わかった" class="home-tip-dismiss" />
                    </ui:VisualElement>
                    <ui:Button name="resume-match" text="つづける" class="cta-button cta-resume hidden" />
                    <ui:Button name="start-match" text="マッチ開始" class="cta-button" />
                </ui:VisualElement>
                <ui:VisualElement class="nav-row">
                    <ui:Button name="open-deck" class="nav-tile">
                        <ui:VisualElement name="icon-deck" class="tile-icon" />
                        <ui:Label name="nav-deck" text="デッキ" class="tile-label" />
                    </ui:Button>
                    <ui:Button name="open-collection" class="nav-tile">
                        <ui:VisualElement name="icon-collection" class="tile-icon" />
                        <ui:Label name="nav-collection" text="コレクション" class="tile-label" />
                    </ui:Button>
                    <ui:Button name="open-options" class="nav-tile">
                        <ui:VisualElement name="icon-options" class="tile-icon" />
                        <ui:Label name="nav-options" text="オプション" class="tile-label" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="options-panel" class="destination-page options-panel hidden">
                <ui:VisualElement class="destination-chrome">
                    <ui:Button name="close-options" text="← もどる" class="destination-back options-back" />
                    <ui:Label name="options-title" text="オプション" class="destination-title" />
                </ui:VisualElement>
                <ui:ScrollView name="options-scroll" class="options-body options-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:Label name="opt-section-volume" text="音量" class="options-section options-section-first" />
                    <ui:Label name="opt-master-value" text="マスター 100" class="options-label" />
                    <ui:Slider name="opt-master" low-value="0" high-value="100" value="100" class="options-slider" />
                    <ui:Label name="opt-bgm-value" text="BGM 70" class="options-label" />
                    <ui:Slider name="opt-bgm" low-value="0" high-value="100" value="70" class="options-slider" />
                    <ui:Label name="opt-se-value" text="SE 80" class="options-label" />
                    <ui:Slider name="opt-se" low-value="0" high-value="100" value="80" class="options-slider" />
                    <ui:Label name="opt-note-volume" text="マスターは今すぐ変わります。BGM と SE は音が入ると、この割合で鳴ります。" class="options-note" />

                    <ui:Label name="opt-section-match" text="対戦" class="options-section" />
                    <ui:Label name="opt-flick-value" text="フリックの強さ 100" class="options-label" />
                    <ui:Slider name="opt-flick" low-value="50" high-value="150" value="100" class="options-slider" />
                    <ui:Label name="opt-turn-value" text="1ターン 20秒" class="options-label" />
                    <ui:Slider name="opt-turn" low-value="10" high-value="60" value="20" class="options-slider" />
                    <ui:Button name="opt-shake" text="カメラ揺れ: ON" class="options-toggle on" />
                    <ui:Label name="opt-note-match" text="フリックの強さ、ターン時間、カメラ揺れは保存されます。試合側がこの値を読むと効きます。" class="options-note" />

                    <ui:Label name="opt-section-display" text="表示" class="options-section" />
                    <ui:Label name="opt-ui-size" text="画面の大きさ" class="options-label" />
                    <ui:VisualElement class="options-choice-row">
                        <ui:Button name="opt-ui-80" text="小" class="options-choice" />
                        <ui:Button name="opt-ui-100" text="標準" class="options-choice selected" />
                        <ui:Button name="opt-ui-120" text="大" class="options-choice" />
                    </ui:VisualElement>

                    <ui:Label name="opt-section-access" text="見やすさ" class="options-section" />
                    <ui:Button name="opt-reduce-motion" text="動きを減らす: OFF" class="options-toggle" />
                    <ui:Button name="opt-seat-palette" text="座席の色: 標準" class="options-toggle" />
                    <ui:VisualElement name="opt-seat-swatches" class="options-swatches">
                        <ui:VisualElement name="opt-swatch-0" class="options-swatch" />
                        <ui:VisualElement name="opt-swatch-1" class="options-swatch" />
                        <ui:VisualElement name="opt-swatch-2" class="options-swatch" />
                        <ui:VisualElement name="opt-swatch-3" class="options-swatch" />
                    </ui:VisualElement>
                    <ui:Label name="opt-note-access" text="動きを減らすと、画面端の光は点滅せず、うすく固定されます。座席の色は次の試合のコマと表示に使います。" class="options-note" />

                    <ui:Label name="opt-section-dev" text="開発" class="options-section" />
                    <ui:Button name="opt-debug-mode" text="デバッグモード: ON" class="options-debug-button debug-on" />
                    <ui:Label name="opt-note-debug" text="リリース前にこのボタンを非表示にします。" class="options-note" />

                    <ui:Button name="opt-reset" text="初期値に戻す" class="options-reset" />
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement name="deck-panel" class="destination-page deck-panel hidden">
                <ui:VisualElement class="destination-chrome">
                    <ui:Button name="close-deck" text="← もどる" class="destination-back" />
                    <ui:Label name="deck-title" text="デッキ" class="destination-title" />
                </ui:VisualElement>
                <ui:VisualElement class="deck-seats">
                    <ui:Button name="deck-seat-0" text="P1" class="collection-tab selected" />
                    <ui:Button name="deck-seat-1" text="P2" class="collection-tab" />
                    <ui:Button name="deck-seat-2" text="P3" class="collection-tab" />
                    <ui:Button name="deck-seat-3" text="P4" class="collection-tab" />
                </ui:VisualElement>
                <ui:VisualElement name="deck-budget" class="deck-budget">
                    <ui:VisualElement class="deck-budget-head">
                        <ui:Label name="deck-budget-label" text="デッキコスト 0/8" class="deck-budget-label" />
                        <ui:Label name="deck-budget-remain" text="残り 8" class="deck-budget-remain" />
                    </ui:VisualElement>
                    <ui:VisualElement class="deck-budget-track">
                        <ui:VisualElement name="deck-budget-fill" class="deck-budget-fill" />
                    </ui:VisualElement>
                    <ui:Label name="deck-budget-warning" text="" class="deck-budget-warning hidden" />
                    <ui:Button name="deck-save" text="保存" class="deck-save" />
                </ui:VisualElement>
                <ui:Label name="deck-status" text="" class="collection-detail-meta" />
                <ui:Label name="deck-detail" text="" class="collection-detail-body" />
                <ui:VisualElement class="collection-body">
                    <ui:VisualElement class="deck-column">
                        <ui:Label name="deck-col-character" text="キャラ" class="deck-column-title" />
                        <ui:ScrollView name="deck-character-list" class="collection-list deck-list" />
                    </ui:VisualElement>
                    <ui:VisualElement class="deck-column">
                        <ui:Label name="deck-col-common" text="コモンカード" class="deck-column-title" />
                        <ui:Label name="deck-empty" text="デッキは空です。カードの「追加」で入れてください。" class="deck-empty" />
                        <ui:ScrollView name="deck-card-list" class="collection-list deck-list" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="collection-panel" class="destination-page collection-panel hidden">
                <ui:VisualElement class="destination-chrome">
                    <ui:Button name="close-collection" text="← もどる" class="destination-back" />
                    <ui:Label name="collection-title" text="コレクション" class="destination-title" />
                </ui:VisualElement>
                <ui:VisualElement class="collection-tabs">
                    <ui:Button name="collection-tab-characters" text="キャラ" class="collection-tab selected" />
                    <ui:Button name="collection-tab-cards" text="カード" class="collection-tab" />
                </ui:VisualElement>
                <ui:VisualElement name="collection-filters" class="collection-filters" />
                <ui:ScrollView name="collection-strip-scroll" class="collection-strip-scroll" horizontal-scroller-visibility="AlwaysVisible" vertical-scroller-visibility="Hidden">
                    <ui:VisualElement name="collection-strip" class="collection-strip" />
                </ui:ScrollView>
                <ui:VisualElement class="collection-feature">
                    <ui:VisualElement name="collection-portrait" class="collection-portrait" />
                    <ui:VisualElement class="collection-detail">
                        <ui:Label name="collection-detail-title" text="キャラを選んでください" class="collection-detail-title" />
                        <ui:Label name="collection-detail-unlock" text="" class="collection-detail-unlock" />
                        <ui:Label name="collection-detail-meta" text="" class="collection-detail-meta" />
                        <ui:Label name="collection-detail-body" text="" class="collection-detail-body" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
