<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="StartMenu.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="backdrop" class="backdrop" />
        <ui:VisualElement name="menu-content" class="menu-content">
            <ui:VisualElement class="brand-row">
                <ui:VisualElement class="brand-text">
                    <ui:Label text="消しピンウォーズ" class="title-ja" />
                    <ui:Label text="ERASER WARS" class="title-en" />
                </ui:VisualElement>
                <ui:VisualElement name="brand-icon" class="brand-icon" />
            </ui:VisualElement>
            <ui:VisualElement class="spacer" />
            <ui:Button name="resume-match" text="つづける" class="cta-button cta-resume hidden" />
            <ui:Button name="start-match" text="マッチ開始" class="cta-button" />
            <ui:VisualElement class="tile-row">
                <ui:Button name="mode-2p" class="tile tile-pink">
                    <ui:VisualElement name="icon-2p" class="tile-icon" />
                    <ui:Label text="ホットシート 2P" class="tile-label" />
                </ui:Button>
                <ui:Button name="mode-4p" class="tile tile-yellow">
                    <ui:VisualElement name="icon-4p" class="tile-icon" />
                    <ui:Label text="ホットシート 4P" class="tile-label" />
                </ui:Button>
                <ui:Button name="open-deck" class="tile tile-pink">
                    <ui:VisualElement name="icon-deck" class="tile-icon" />
                    <ui:Label text="デッキ" class="tile-label" />
                </ui:Button>
                <ui:Button name="open-collection" class="tile tile-yellow">
                    <ui:VisualElement name="icon-collection" class="tile-icon" />
                    <ui:Label text="コレクション" class="tile-label" />
                </ui:Button>
                <ui:Button name="open-options" class="tile tile-blue">
                    <ui:VisualElement name="icon-options" class="tile-icon" />
                    <ui:Label text="オプション" class="tile-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="options-panel" class="side-panel hidden">
            <ui:Label text="オプション" class="panel-title" />
            <ui:Label text="音量・言語は後続。Esc で閉じる。" class="panel-body" />
            <ui:Button name="close-options" text="閉じる" class="panel-close" />
        </ui:VisualElement>
        <ui:VisualElement name="deck-panel" class="side-panel hidden">
            <ui:Label text="デッキ" class="panel-title" />
            <ui:Label text="デッキ編成は後続。枠だけ先行。" class="panel-body" />
            <ui:Button name="close-deck" text="閉じる" class="panel-close" />
        </ui:VisualElement>
        <ui:VisualElement name="collection-panel" class="side-panel collection-panel hidden">
            <ui:VisualElement class="collection-header">
                <ui:Label text="コレクション" class="panel-title" />
                <ui:Button name="close-collection" text="閉じる" class="panel-close collection-close" />
            </ui:VisualElement>
            <ui:VisualElement class="collection-tabs">
                <ui:Button name="collection-tab-characters" text="キャラ" class="collection-tab selected" />
                <ui:Button name="collection-tab-cards" text="カード" class="collection-tab" />
            </ui:VisualElement>
            <ui:VisualElement name="collection-filters" class="collection-filters" />
            <ui:VisualElement class="collection-body">
                <ui:ScrollView name="collection-list" class="collection-list" />
                <ui:VisualElement class="collection-detail">
                    <ui:Label name="collection-detail-title" text="キャラを選んでください" class="collection-detail-title" />
                    <ui:Label name="collection-detail-meta" text="" class="collection-detail-meta" />
                    <ui:Label name="collection-detail-body" text="" class="collection-detail-body" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
