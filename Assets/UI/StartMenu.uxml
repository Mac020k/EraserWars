<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="StartMenu.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="backdrop" class="backdrop" />
        <ui:VisualElement name="menu-content" class="menu-content">
            <ui:VisualElement name="home-stack" class="home-stack">
                <ui:VisualElement class="brand-row">
                    <ui:VisualElement class="brand-text">
                        <ui:Label name="title-ja" text="消しピンウォーズ" class="title-ja" />
                        <ui:Label name="title-en" text="ERASER WARS" class="title-en" />
                    </ui:VisualElement>
                    <ui:VisualElement name="brand-icon" class="brand-icon" />
                </ui:VisualElement>
                <ui:VisualElement class="spacer" />
                <ui:VisualElement class="action-stack">
                    <ui:VisualElement class="mode-segment">
                        <ui:Button name="mode-2p" text="2人対戦" class="mode-chip selected" />
                        <ui:Button name="mode-4p" text="4人対戦" class="mode-chip" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mode-segment">
                        <ui:Button name="mode-stock" text="ストック戦" class="mode-chip selected" />
                        <ui:Button name="mode-points" text="ポイント戦" class="mode-chip" />
                    </ui:VisualElement>
                    <ui:ScrollView name="seat-strip-scroll" class="seat-strip-scroll" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden">
                        <ui:VisualElement name="seat-strip" class="seat-strip" />
                    </ui:ScrollView>
                    <ui:VisualElement name="seat-picker" class="seat-picker hidden">
                        <ui:Label name="seat-picker-caption" text="" class="seat-picker-caption" />
                        <ui:ScrollView name="seat-picker-scroll" class="seat-picker-scroll" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden">
                            <ui:VisualElement name="seat-picker-row" class="seat-picker-row" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement name="home-tip" class="home-tip">
                        <ui:Label name="home-tip-copy" text="机から落としたらストックが1つ減る。最後まで残った人が勝ち。カードは出しても出さなくてもいい。出したらドラッグではじく。" class="home-tip-copy" />
                        <ui:Button name="home-tip-dismiss" text="わかった" class="home-tip-dismiss" />
                    </ui:VisualElement>
                    <ui:Button name="resume-match" text="つづける" class="cta-button cta-resume hidden" />
                    <ui:Button name="start-match" text="マッチ開始" class="cta-button" />
                    <ui:Button name="open-secret-room" text="ひみつのへや" class="secret-room-entry" />
                </ui:VisualElement>
                <ui:VisualElement class="nav-row">
                    <ui:Button name="open-deck" class="nav-tile">
                        <ui:VisualElement name="icon-deck" class="tile-icon" />
                        <ui:Label name="nav-deck" text="デッキ" class="tile-label" />
                    </ui:Button>
                    <ui:Button name="open-collection" class="nav-tile">
                        <ui:VisualElement name="icon-collection" class="tile-icon" />
                        <ui:Label name="nav-collection" text="コレクション" class="tile-label" />
                    </ui:Button>
                    <ui:Button name="open-options" class="nav-tile">
                        <ui:VisualElement name="icon-options" class="tile-icon" />
                        <ui:Label name="nav-options" text="オプション" class="tile-label" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="options-panel" class="destination-page options-panel hidden">
                <ui:VisualElement class="destination-chrome">
                    <ui:Button name="close-options" text="← もどる" class="destination-back options-back" />
                    <ui:Label name="options-title" text="オプション" class="destination-title" />
                    <ui:VisualElement name="options-eraser" class="options-eraser" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:ScrollView name="options-scroll" class="options-body options-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:VisualElement name="opt-card-volume" class="options-card options-card-first">
                        <ui:Label name="opt-section-volume" text="音量" class="options-section" />
                        <ui:Label name="opt-master-value" text="マスター 100" class="options-label" />
                        <ui:Slider name="opt-master" low-value="0" high-value="100" value="100" class="options-slider" />
                        <ui:Label name="opt-bgm-value" text="BGM 70" class="options-label" />
                        <ui:Slider name="opt-bgm" low-value="0" high-value="100" value="70" class="options-slider" />
                        <ui:Label name="opt-se-value" text="SE 80" class="options-label" />
                        <ui:Slider name="opt-se" low-value="0" high-value="100" value="80" class="options-slider" />
                        <ui:Label name="opt-note-volume" text="マスターは今すぐ変わります。BGM と SE は音が入ると、この割合で鳴ります。" class="options-note" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-card-match" class="options-card">
                        <ui:Label name="opt-section-match" text="対戦" class="options-section" />
                        <ui:Label name="opt-flick-value" text="フリックの強さ 100" class="options-label" />
                        <ui:Slider name="opt-flick" low-value="50" high-value="150" value="100" class="options-slider" />
                        <ui:Label name="opt-turn-value" text="1ターン 20秒" class="options-label" />
                        <ui:Slider name="opt-turn" low-value="10" high-value="60" value="20" class="options-slider" />
                        <ui:Button name="opt-shake" text="カメラ揺れ: ON" class="options-toggle on">
                            <ui:VisualElement class="options-switch" picking-mode="Ignore">
                                <ui:VisualElement class="options-switch-knob" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Label name="opt-note-match" text="フリックの強さ、ターン時間、カメラ揺れは保存されます。試合側がこの値を読むと効きます。" class="options-note" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-card-display" class="options-card">
                        <ui:Label name="opt-section-display" text="表示" class="options-section" />
                        <ui:Label name="opt-ui-size" text="画面の大きさ" class="options-label" />
                        <ui:VisualElement class="options-choice-row">
                            <ui:Label name="opt-ui-120" text="大" class="options-choice selected" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-card-access" class="options-card">
                        <ui:Label name="opt-section-access" text="見やすさ" class="options-section" />
                        <ui:Button name="opt-reduce-motion" text="動きを減らす: OFF" class="options-toggle">
                            <ui:VisualElement class="options-switch" picking-mode="Ignore">
                                <ui:VisualElement class="options-switch-knob" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="opt-seat-palette" text="座席の色: 標準" class="options-toggle">
                            <ui:VisualElement class="options-switch" picking-mode="Ignore">
                                <ui:VisualElement class="options-switch-knob" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:VisualElement name="opt-seat-swatches" class="options-swatches">
                            <ui:VisualElement name="opt-swatch-0" class="options-swatch" />
                            <ui:VisualElement name="opt-swatch-1" class="options-swatch" />
                            <ui:VisualElement name="opt-swatch-2" class="options-swatch" />
                            <ui:VisualElement name="opt-swatch-3" class="options-swatch" />
                        </ui:VisualElement>
                        <ui:Label name="opt-note-access" text="動きを減らすと、画面端の光は点滅せず、うすく固定されます。座席の色は次の試合のコマと表示に使います。" class="options-note" />
                    </ui:VisualElement>
                    <ui:VisualElement name="opt-card-dev" class="options-card options-card-dev">
                        <ui:Label name="opt-section-dev" text="開発" class="options-section" />
                        <ui:Button name="opt-debug-mode" text="デバッグモード: ON" class="options-toggle options-debug-button debug-on">
                            <ui:VisualElement class="options-switch" picking-mode="Ignore">
                                <ui:VisualElement class="options-switch-knob" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Button name="opt-reset" text="初期値に戻す" class="options-reset" />
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement name="deck-panel" class="destination-page deck-panel hidden">
                <ui:VisualElement class="destination-chrome">
                    <ui:Button name="close-deck" text="← もどる" class="destination-back" />
                    <ui:Label name="deck-title" text="デッキ" class="destination-title" />
                </ui:VisualElement>
                <ui:VisualElement class="deck-seats">
                    <ui:Button name="deck-seat-0" text="P1" class="collection-tab selected" />
                    <ui:Button name="deck-seat-1" text="P2" class="collection-tab" />
                    <ui:Button name="deck-seat-2" text="P3" class="collection-tab" />
                    <ui:Button name="deck-seat-3" text="P4" class="collection-tab" />
                </ui:VisualElement>
                <ui:VisualElement class="deck-binder">
                    <ui:VisualElement class="deck-page deck-page-left">
                        <ui:Label name="deck-ribbon" text="プレイヤー" class="deck-ribbon" />
                        <ui:ScrollView name="deck-left-scroll" class="deck-left-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                            <ui:VisualElement class="deck-portrait-ring">
                                <ui:VisualElement name="deck-portrait" class="deck-portrait" />
                            </ui:VisualElement>
                            <ui:Label name="deck-profile-name" text="未選択" class="deck-name" />
                            <ui:Label name="deck-archetype" text="" class="deck-archetype" />
                            <ui:VisualElement class="deck-stat-table">
                                <ui:VisualElement class="deck-stat-row">
                                    <ui:VisualElement name="deck-stat-icon-mass" class="deck-stat-icon" />
                                    <ui:Label text="質量" class="deck-stat-label" />
                                    <ui:Label name="deck-stat-mass" text="" class="deck-stat-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="deck-stat-row">
                                    <ui:VisualElement name="deck-stat-icon-cap" class="deck-stat-icon" />
                                    <ui:Label text="コスト上限" class="deck-stat-label" />
                                    <ui:Label name="deck-stat-cap" text="" class="deck-stat-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="deck-stat-row">
                                    <ui:VisualElement name="deck-stat-icon-subject" class="deck-stat-icon" />
                                    <ui:Label text="得意 / 苦手" class="deck-stat-label" />
                                    <ui:Label name="deck-stat-subject" text="" class="deck-stat-value" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label name="deck-flavor" text="" class="deck-flavor" />
                            <ui:Label name="deck-col-signature" text="とくぎ" class="deck-column-title" />
                            <ui:VisualElement name="deck-signatures" class="deck-signatures" />
                        </ui:ScrollView>
                        <ui:Label name="deck-col-character" text="キャラ" class="deck-column-title deck-chip-title" />
                        <ui:ScrollView name="deck-character-list" class="deck-chip-strip" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" />
                    </ui:VisualElement>
                    <ui:VisualElement class="deck-spiral">
                        <ui:VisualElement class="deck-ring" />
                        <ui:VisualElement class="deck-ring" />
                        <ui:VisualElement class="deck-ring" />
                        <ui:VisualElement class="deck-ring" />
                        <ui:VisualElement class="deck-ring" />
                        <ui:VisualElement class="deck-ring" />
                        <ui:VisualElement class="deck-ring" />
                    </ui:VisualElement>
                    <ui:VisualElement class="deck-page deck-page-right">
                        <ui:VisualElement class="deck-head">
                            <ui:VisualElement class="deck-head-copy">
                                <ui:Label name="deck-col-common" text="コモンカード" class="deck-headline" />
                                <ui:Label name="deck-status" text="" class="deck-status" />
                            </ui:VisualElement>
                            <ui:VisualElement class="deck-presets">
                                <ui:Label name="deck-preset-name" text="プリセット1" class="deck-preset-name" />
                                <ui:Button name="deck-preset-0" text="1" class="deck-preset selected" />
                                <ui:Button name="deck-preset-1" text="2" class="deck-preset" />
                                <ui:Button name="deck-preset-2" text="3" class="deck-preset" />
                                <ui:Button name="deck-preset-3" text="4" class="deck-preset" />
                                <ui:Button name="deck-preset-4" text="5" class="deck-preset" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="deck-family-bar" class="deck-family-bar" />
                        <ui:Label name="deck-empty" text="デッキは空です。カードの「追加」で入れてください。" class="deck-empty" />
                        <ui:ScrollView name="deck-card-list" class="deck-grid" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                        <ui:VisualElement name="deck-budget" class="deck-budget">
                            <ui:VisualElement class="deck-budget-main">
                                <ui:VisualElement class="deck-budget-head">
                                    <ui:Label name="deck-budget-label" text="デッキコスト 0/8" class="deck-budget-label" />
                                    <ui:Label name="deck-budget-remain" text="残り 8" class="deck-budget-remain" />
                                </ui:VisualElement>
                                <ui:VisualElement class="deck-budget-track">
                                    <ui:VisualElement name="deck-budget-fill" class="deck-budget-fill" />
                                </ui:VisualElement>
                                <ui:Label name="deck-budget-warning" text="" class="deck-budget-warning hidden" />
                            </ui:VisualElement>
                            <ui:Button name="deck-save" text="保存" class="deck-save" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="collection-panel" class="destination-page collection-panel hidden">
                <ui:VisualElement class="destination-chrome">
                    <ui:Button name="close-collection" text="← もどる" class="destination-back" />
                    <ui:Label name="collection-title" text="コレクション" class="destination-title" />
                </ui:VisualElement>
                <ui:VisualElement class="collection-tabs">
                    <ui:Button name="collection-tab-characters" text="キャラ" class="collection-tab selected" />
                    <ui:Button name="collection-tab-cards" text="カード" class="collection-tab" />
                </ui:VisualElement>
                <ui:VisualElement name="collection-filters" class="collection-filters" />
                <ui:ScrollView name="collection-strip-scroll" class="collection-strip-scroll" mode="Horizontal" horizontal-scroller-visibility="AlwaysVisible" vertical-scroller-visibility="Hidden">
                    <ui:VisualElement name="collection-strip" class="collection-strip" />
                </ui:ScrollView>
                <ui:VisualElement class="collection-feature">
                    <ui:VisualElement name="collection-preview" class="collection-preview">
                        <ui:VisualElement name="collection-stage" class="collection-stage">
                            <ui:VisualElement name="collection-portrait" class="collection-portrait" />
                            <ui:VisualElement name="collection-eraser-3d" class="collection-preview-panel hidden">
                                <ui:Label name="collection-eraser-3d-kicker" text="3D消しゴム" class="collection-preview-kicker" />
                                <ui:Label name="collection-eraser-3d-slot" text="モデル枠" class="collection-slot-caption" />
                            </ui:VisualElement>
                            <ui:VisualElement name="collection-eraser-design" class="collection-preview-panel hidden">
                                <ui:Label name="collection-eraser-design-kicker" text="消しゴムデザイン" class="collection-preview-kicker" />
                                <ui:Label name="collection-eraser-design-slot" text="デザイン枠" class="collection-slot-caption" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="collection-preview-modes" class="collection-preview-modes">
                            <ui:Button name="collection-mode-still" text="立ち絵" class="collection-preview-mode selected" />
                            <ui:Button name="collection-mode-3d" text="3D" class="collection-preview-mode" />
                            <ui:Button name="collection-mode-design" text="デザイン" class="collection-preview-mode" />
                        </ui:VisualElement>
                        <ui:VisualElement name="collection-card-slots" class="collection-card-slots hidden">
                            <ui:VisualElement name="collection-grant-slot" class="collection-card-slot">
                                <ui:Label name="collection-grant-kicker" text="付与演出" class="collection-preview-kicker" />
                                <ui:Label name="collection-grant-caption" text="準備中" class="collection-slot-caption" />
                            </ui:VisualElement>
                            <ui:VisualElement name="collection-play-slot" class="collection-card-slot">
                                <ui:Label name="collection-play-kicker" text="プレイ演出" class="collection-preview-kicker" />
                                <ui:Label name="collection-play-caption" text="準備中" class="collection-slot-caption" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView class="collection-detail" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:Label name="collection-detail-title" text="キャラを選んでください" class="collection-detail-title" />
                        <ui:Label name="collection-detail-unlock" text="" class="collection-detail-unlock" />
                        <ui:VisualElement name="collection-arch-row" class="collection-arch-row" />
                        <ui:Label name="collection-detail-meta" text="" class="collection-detail-meta" />
                        <ui:VisualElement name="collection-detail-subjects" class="collection-subjects" />
                        <ui:Label name="collection-detail-body" text="" class="collection-detail-body" />
                        <ui:Label name="collection-passive" text="" class="collection-passive" />
                        <ui:VisualElement name="collection-signatures" class="collection-signatures" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="secret-room-panel" class="destination-page secret-room-panel hidden">
                <ui:VisualElement class="destination-chrome">
                    <ui:Button name="close-secret-room" text="← もどる" class="destination-back" />
                    <ui:Label name="secret-room-title" text="ひみつのへや" class="destination-title" />
                </ui:VisualElement>
                <ui:Label name="secret-room-note" text="まだ通信しません。コードはこの端末の中だけです。" class="options-note" />
                <ui:Label name="secret-room-code-label" text="参加コード" class="options-label" />
                <ui:TextField name="join-code" class="secret-room-code" max-length="6" />
                <ui:VisualElement class="secret-room-actions">
                    <ui:Button name="secret-generate" text="コードをつくる" class="options-choice" />
                    <ui:Button name="secret-copy" text="コピー" class="options-choice" />
                </ui:VisualElement>
                <ui:Label name="secret-status" text="" class="options-note" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
