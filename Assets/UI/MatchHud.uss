@import url("CardFace.uss");

.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.hud-root.hidden {
    display: none;
}

.top-bar {
    position: absolute;
    left: 1.2%;
    right: 1.2%;
    top: 1.2%;
    height: 6.5%;
    min-height: 40px;
    max-height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 0 1.2%;
    background-color: rgba(255, 244, 248, 0.94);
    border-radius: 16px;
    border-width: 3px;
    border-color: rgb(255, 120, 160);
}

.brand-chip {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    background-color: rgb(255, 120, 160);
    border-radius: 8px;
    border-bottom-width: 8px;
    border-bottom-color: rgb(70, 130, 240);
    flex-shrink: 0;
}

.hud-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(230, 70, 120);
    margin-right: 18px;
    flex-shrink: 0;
}

.hud-phase {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(70, 60, 80);
    flex-grow: 1;
}

.hud-turn {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(255, 120, 160);
    border-radius: 14px;
    padding: 4px 16px;
    margin-right: 12px;
    flex-shrink: 0;
}

.hud-turn.seat-0 { background-color: rgb(255, 120, 160); }
.hud-turn.seat-1 { background-color: rgb(70, 130, 240); }
.hud-turn.seat-2 { background-color: rgb(70, 190, 100); }
.hud-turn.seat-3 { background-color: rgb(255, 160, 50); }
.hud-turn.turn-over { background-color: rgb(120, 110, 130); }

.hud-timer {
    min-width: 96px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(70, 60, 80);
    background-color: rgb(255, 255, 255);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(70, 60, 80);
    padding: 2px 12px;
    margin-right: 12px;
    flex-shrink: 0;
}

.hud-timer.timer-urgent {
    color: rgb(255, 255, 255);
    background-color: rgb(235, 60, 70);
    border-color: rgb(150, 20, 40);
    scale: 1.1 1.1;
}

.hud-timer.timer-idle {
    opacity: 0.45;
}

.hud-menu-button {
    width: 100px;
    height: 80%;
    min-height: 32px;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 12px;
    flex-shrink: 0;
}

.players-row {
    position: absolute;
    left: 1.2%;
    right: 1.2%;
    top: 9%;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.player-pill {
    min-width: 140px;
    width: 18%;
    max-width: 220px;
    margin: 0 0.5%;
    padding: 6px 12px 8px 12px;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 16px;
    border-width: 3px;
    border-color: rgb(210, 210, 210);
    opacity: 0.82;
}

.player-pill.seat-0 { border-color: rgb(255, 120, 160); }
.player-pill.seat-1 { border-color: rgb(70, 130, 240); }
.player-pill.seat-2 { border-color: rgb(70, 190, 100); }
.player-pill.seat-3 { border-color: rgb(255, 160, 50); }

.pill-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    border-radius: 10px;
    padding: 1px 14px;
    margin-bottom: 4px;
}

.seat-0 .pill-name { background-color: rgb(255, 120, 160); }
.seat-1 .pill-name { background-color: rgb(70, 130, 240); }
.seat-2 .pill-name { background-color: rgb(70, 190, 100); }
.seat-3 .pill-name { background-color: rgb(255, 160, 50); }

.pill-hearts {
    flex-direction: row;
    margin-bottom: 2px;
}

.heart {
    width: 16px;
    height: 16px;
    margin: 0 2px;
    border-radius: 8px;
    background-color: rgb(240, 70, 100);
}

.heart {
    flex-shrink: 0;
}

.heart.has-icon {
    width: 22px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.heart.heart-lost {
    background-color: rgb(200, 200, 205);
    -unity-background-image-tint-color: rgb(190, 190, 195);
}

.heart.has-icon.heart-lost {
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.35;
}

.pill-points {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(70, 60, 80);
}

.player-pill.pill-active {
    opacity: 1;
    border-width: 5px;
    background-color: rgb(255, 250, 225);
    scale: 1.08 1.08;
}

.player-pill.pill-out {
    opacity: 0.4;
}

.result-banner {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 38%;
    padding: 18px 24px;
    align-items: center;
    background-color: rgba(255, 250, 225, 0.96);
    border-radius: 24px;
    border-width: 6px;
    border-color: rgb(210, 210, 210);
}

.result-banner.hidden { display: none; }
.result-banner.seat-0 { border-color: rgb(255, 120, 160); }
.result-banner.seat-1 { border-color: rgb(70, 130, 240); }
.result-banner.seat-2 { border-color: rgb(70, 190, 100); }
.result-banner.seat-3 { border-color: rgb(255, 160, 50); }

.result-text {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(70, 60, 80);
}

.result-hint {
    margin-top: 4px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(120, 110, 130);
}

.result-banner.seat-0 .result-text { color: rgb(230, 70, 120); }
.result-banner.seat-1 .result-text { color: rgb(50, 100, 220); }
.result-banner.seat-2 .result-text { color: rgb(40, 150, 70); }
.result-banner.seat-3 .result-text { color: rgb(220, 120, 20); }

.hand-dock {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 12%;
    align-items: center;
}

.hand-dock.hidden {
    display: none;
}

.hand-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(255, 120, 160);
    border-radius: 12px;
    padding: 2px 16px;
    margin-bottom: 6px;
}

.hand-dock.seat-0 .hand-title { background-color: rgb(255, 120, 160); }
.hand-dock.seat-1 .hand-title { background-color: rgb(70, 130, 240); }
.hand-dock.seat-2 .hand-title { background-color: rgb(70, 190, 100); }
.hand-dock.seat-3 .hand-title { background-color: rgb(255, 160, 50); }

.hand-row {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    flex-wrap: wrap;
}

.hand-card {
    width: 112px;
    height: 158px;
    min-width: 112px;
    max-width: 112px;
    margin: 0 5px 4px 5px;
    flex-shrink: 0;
}

.hand-card:hover {
    scale: 1.06 1.06;
    translate: 0 -10px;
}

.hand-card:active {
    scale: 0.97 0.97;
    translate: 0 -2px;
}

.action-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3%;
    flex-direction: row;
    justify-content: center;
}

.action-chip {
    height: 6.5%;
    min-height: 40px;
    max-height: 56px;
    min-width: 120px;
    width: 14%;
    max-width: 200px;
    margin: 0 0.8%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

.action-pass { background-color: rgb(255, 120, 160); }
.action-rematch { background-color: rgb(70, 130, 240); }

.action-chip.hidden {
    display: none;
}

.action-chip:disabled {
    opacity: 0.4;
}

.action-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.action-icon {
    display: none;
    width: 26px;
    height: 26px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.action-icon.has-icon {
    display: flex;
}
