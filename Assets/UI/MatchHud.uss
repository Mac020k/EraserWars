@import url("CardFace.uss");

.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.hud-root.hidden {
    display: none;
}

.hud-stack {
    position: absolute;
    left: 1.2%;
    right: 1.2%;
    top: 1.2%;
    flex-direction: column;
}

.top-bar {
    height: 48px;
    width: 100%;
    flex-direction: row;
    align-items: center;
    padding: 0 1.2%;
    background-color: rgba(255, 244, 248, 0.94);
    border-radius: 16px;
    border-width: 3px;
    border-color: rgb(255, 120, 160);
}

.brand-chip {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    background-color: rgb(255, 120, 160);
    border-radius: 8px;
    border-bottom-width: 8px;
    border-bottom-color: rgb(70, 130, 240);
    flex-shrink: 0;
}

.hud-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(230, 70, 120);
    margin-right: 18px;
    flex-shrink: 0;
}

.hud-phase {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(70, 60, 80);
    flex-grow: 1;
}

.turn-callout {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 96px;
    margin-top: 8px;
    padding: 10px 18px 10px 22px;
    background-color: rgba(255, 252, 248, 0.96);
    border-radius: 22px;
    border-width: 6px;
    border-color: rgb(180, 170, 184);
}

.turn-callout.hidden {
    display: none;
}

.turn-copy {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.hud-turn {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(50, 42, 60);
    white-space: nowrap;
}

.pass-hint {
    margin-top: 2px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(50, 42, 60);
    white-space: nowrap;
}

.pass-hint.hidden {
    display: none;
}

.turn-callout.seat-0 { border-color: rgb(255, 120, 160); }
.turn-callout.seat-1 { border-color: rgb(70, 130, 240); }
.turn-callout.seat-2 { border-color: rgb(70, 190, 100); }
.turn-callout.seat-3 { border-color: rgb(255, 160, 50); }

.turn-callout.seat-0 .hud-turn,
.turn-callout.seat-0 .pass-hint { color: rgb(176, 32, 84); }
.turn-callout.seat-1 .hud-turn,
.turn-callout.seat-1 .pass-hint { color: rgb(28, 72, 176); }
.turn-callout.seat-2 .hud-turn,
.turn-callout.seat-2 .pass-hint { color: rgb(16, 118, 52); }
.turn-callout.seat-3 .hud-turn,
.turn-callout.seat-3 .pass-hint { color: rgb(176, 88, 8); }

.timer-box {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 148px;
    height: 84px;
    margin-left: 16px;
    padding: 0 12px 0 16px;
    background-color: rgb(255, 255, 255);
    border-radius: 18px;
    border-width: 4px;
    border-color: rgb(40, 32, 48);
    flex-shrink: 0;
}

.hud-timer {
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(28, 22, 36);
}

.timer-unit {
    margin-left: 2px;
    margin-bottom: 8px;
    align-self: flex-end;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(40, 32, 48);
}

.timer-unit.hidden {
    display: none;
}

.timer-box.timer-urgent {
    background-color: rgb(214, 32, 48);
    border-color: rgb(120, 12, 24);
}

.timer-box.timer-urgent .hud-timer,
.timer-box.timer-urgent .timer-unit {
    color: rgb(255, 255, 255);
}

.timer-box.timer-idle {
    background-color: rgb(236, 232, 236);
    border-color: rgb(170, 160, 174);
}

.timer-box.timer-idle .hud-timer {
    color: rgb(90, 82, 98);
}

.turn-yield {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
    border-radius: 12px;
    border-width: 3px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    background-color: rgb(255, 236, 168);
    color: rgb(70, 42, 8);
}

.turn-yield.hidden {
    display: none;
}

.turn-yield.yield-pass {
    background-color: rgb(255, 236, 168);
    color: rgb(70, 42, 8);
}

.turn-yield.yield-time {
    background-color: rgb(214, 32, 48);
    color: rgb(255, 255, 255);
}

.turn-yield.seat-0 { border-color: rgb(255, 120, 160); }
.turn-yield.seat-1 { border-color: rgb(70, 130, 240); }
.turn-yield.seat-2 { border-color: rgb(70, 190, 100); }
.turn-yield.seat-3 { border-color: rgb(255, 160, 50); }

.hud-menu-button {
    width: 100px;
    height: 80%;
    min-height: 32px;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 12px;
    flex-shrink: 0;
}

.players-row {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
    margin-top: 8px;
}

.player-pill {
    min-width: 140px;
    width: 18%;
    max-width: 220px;
    margin: 0 0.5%;
    padding: 6px 12px 8px 12px;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 16px;
    border-width: 3px;
    border-color: rgb(210, 210, 210);
    opacity: 0.82;
}

.player-pill.seat-0 { border-color: rgb(255, 120, 160); }
.player-pill.seat-1 { border-color: rgb(70, 130, 240); }
.player-pill.seat-2 { border-color: rgb(70, 190, 100); }
.player-pill.seat-3 { border-color: rgb(255, 160, 50); }

.pill-now {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(40, 32, 48);
    background-color: rgb(255, 214, 48);
    border-radius: 8px;
    padding: 1px 10px;
    margin-bottom: 4px;
}

.pill-now.hidden {
    display: none;
}

.pill-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    border-radius: 10px;
    padding: 1px 14px;
    margin-bottom: 4px;
}

.seat-0 .pill-name { background-color: rgb(255, 120, 160); }
.seat-1 .pill-name { background-color: rgb(70, 130, 240); }
.seat-2 .pill-name { background-color: rgb(70, 190, 100); }
.seat-3 .pill-name { background-color: rgb(255, 160, 50); }

.pill-hearts {
    flex-direction: row;
    margin-bottom: 2px;
}

.heart {
    width: 16px;
    height: 16px;
    margin: 0 2px;
    border-radius: 8px;
    background-color: rgb(240, 70, 100);
}

.heart {
    flex-shrink: 0;
}

.heart.has-icon {
    width: 22px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.heart.heart-lost {
    background-color: rgb(200, 200, 205);
    -unity-background-image-tint-color: rgb(190, 190, 195);
}

.heart.has-icon.heart-lost {
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.35;
}

.pill-points {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(70, 60, 80);
}

.player-pill.pill-active {
    opacity: 1;
    border-width: 6px;
    background-color: rgb(255, 248, 214);
    scale: 1.08 1.08;
}

.player-pill.pill-out {
    opacity: 0.4;
}

.match-end {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.match-end.hidden { display: none; }

.match-end-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(28, 20, 36, 0.38);
}

.match-end-card {
    width: 56%;
    max-width: 680px;
    min-width: 340px;
    padding: 28px 32px 22px 32px;
    align-items: center;
    background-color: rgba(255, 250, 236, 0.97);
    border-radius: 28px;
    border-width: 6px;
    border-color: rgb(120, 110, 130);
}

.match-end-card.seat-0 { border-color: rgb(255, 120, 160); }
.match-end-card.seat-1 { border-color: rgb(70, 130, 240); }
.match-end-card.seat-2 { border-color: rgb(70, 190, 100); }
.match-end-card.seat-3 { border-color: rgb(255, 160, 50); }

.result-kicker {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(120, 110, 130);
    margin-bottom: 4px;
}

.result-text {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(70, 60, 80);
    -unity-text-align: middle-center;
}

.result-summary {
    margin-top: 8px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(70, 60, 80);
    -unity-text-align: middle-center;
    white-space: normal;
}

.match-end-card.seat-0 .result-text { color: rgb(230, 70, 120); }
.match-end-card.seat-1 .result-text { color: rgb(50, 100, 220); }
.match-end-card.seat-2 .result-text { color: rgb(40, 150, 70); }
.match-end-card.seat-3 .result-text { color: rgb(220, 120, 20); }

.match-end-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 20px;
}

.match-end-button {
    min-width: 168px;
    height: 52px;
    margin: 0 8px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    border-radius: 16px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

.match-end-menu { background-color: rgb(255, 120, 160); }

.hand-dock {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 12%;
    align-items: center;
}

.hand-dock.hidden {
    display: none;
}

.hand-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(255, 120, 160);
    border-radius: 12px;
    padding: 2px 16px;
    margin-bottom: 6px;
}

.hand-dock.seat-0 .hand-title { background-color: rgb(255, 120, 160); }
.hand-dock.seat-1 .hand-title { background-color: rgb(70, 130, 240); }
.hand-dock.seat-2 .hand-title { background-color: rgb(70, 190, 100); }
.hand-dock.seat-3 .hand-title { background-color: rgb(255, 160, 50); }

.hand-row {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    flex-wrap: wrap;
}

.hand-card {
    width: 112px;
    height: 158px;
    min-width: 112px;
    max-width: 112px;
    margin: 0 5px 4px 5px;
    flex-shrink: 0;
}

.hand-card:hover {
    scale: 1.06 1.06;
    translate: 0 -10px;
}

.hand-card:active {
    scale: 0.97 0.97;
    translate: 0 -2px;
}

.action-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3%;
    flex-direction: row;
    justify-content: center;
}

.action-chip {
    height: 6.5%;
    min-height: 40px;
    max-height: 56px;
    min-width: 120px;
    width: 14%;
    max-width: 200px;
    margin: 0 0.8%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

.action-pass { background-color: rgb(255, 120, 160); }
.action-rematch { background-color: rgb(70, 130, 240); }

.action-chip.hidden {
    display: none;
}

.action-chip:disabled {
    opacity: 0.4;
}

.action-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.action-icon {
    display: none;
    width: 26px;
    height: 26px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.action-icon.has-icon {
    display: flex;
}

.praise-scrap {
    border-radius: 2px;
    border-bottom-right-radius: 8px;
    border-top-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.92);
}

.card-cutin {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.card-cutin.hidden {
    display: none;
}

.card-cutin-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 12, 22, 0.55);
}

.card-cutin-banner {
    flex-direction: row;
    align-items: center;
    min-width: 640px;
    max-width: 92%;
    min-height: 220px;
    padding: 18px 40px 18px 22px;
    background-color: rgba(255, 252, 248, 0.98);
    border-radius: 28px;
    border-width: 8px;
    border-color: rgb(40, 32, 48);
    rotate: -6deg;
}

.card-cutin-banner.seat-0 { border-color: rgb(255, 120, 160); }
.card-cutin-banner.seat-1 { border-color: rgb(70, 130, 240); }
.card-cutin-banner.seat-2 { border-color: rgb(70, 190, 100); }
.card-cutin-banner.seat-3 { border-color: rgb(255, 160, 50); }

.card-cutin-banner.seat-0 .card-cutin-name { color: rgb(176, 32, 84); }
.card-cutin-banner.seat-1 .card-cutin-name { color: rgb(28, 72, 176); }
.card-cutin-banner.seat-2 .card-cutin-name { color: rgb(16, 118, 52); }
.card-cutin-banner.seat-3 .card-cutin-name { color: rgb(176, 88, 8); }

.card-cutin.card-cutin-signature .card-cutin-banner {
    min-height: 260px;
    background-color: rgb(28, 34, 52);
    border-color: rgb(232, 184, 72);
}

.card-cutin.card-cutin-signature .card-cutin-kicker {
    color: rgb(232, 184, 72);
}

.card-cutin.card-cutin-signature .card-cutin-name {
    color: rgb(255, 246, 220);
    font-size: 72px;
}

.card-cutin-face {
    width: 168px;
    height: 220px;
    margin-right: 28px;
    flex-shrink: 0;
}

.card-cutin-face .card-face-body {
    display: none;
}

.card-cutin-face .card-effect-icon {
    width: 88px;
    height: 88px;
    top: 66px;
    left: 40px;
    right: auto;
}

.card-cutin-face .card-ribbon {
    top: 164px;
}

.card-cutin-copy {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.card-cutin-kicker {
    margin: 0 0 4px 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(80, 70, 88);
}

.card-cutin-name {
    margin: 0;
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(28, 22, 36);
    white-space: normal;
}

