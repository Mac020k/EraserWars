@import url("CardFace.uss");

.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 960px;
    min-height: 540px;
}

.hud-root.hidden {
    display: none;
}

.score-rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 188px;
}

.score-rail-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.players-row {
    position: absolute;
    left: 3%;
    right: 3%;
    top: 16px;
    height: 96px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.player-pill {
    width: 132px;
    min-width: 108px;
    max-width: 160px;
    padding: 8px 10px 8px 10px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    opacity: 0.92;
    transition-property: scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.pill-now {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(40, 32, 48);
    margin-bottom: 2px;
}

.pill-now.hidden {
    display: none;
}

.pill-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    border-radius: 10px;
    padding: 1px 12px;
    margin-bottom: 2px;
}

.seat-0 .pill-name { background-color: rgb(255, 120, 160); }
.seat-1 .pill-name { background-color: rgb(70, 130, 240); }
.seat-2 .pill-name { background-color: rgb(70, 190, 100); }
.seat-3 .pill-name { background-color: rgb(255, 160, 50); }

.pill-hearts {
    flex-direction: row;
    margin-bottom: 2px;
}

.pill-hearts.hidden {
    display: none;
}

.heart {
    width: 14px;
    height: 14px;
    margin: 0 2px;
    border-radius: 7px;
    background-color: rgb(240, 70, 100);
    flex-shrink: 0;
}

.heart.has-icon {
    width: 18px;
    height: 18px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.heart.heart-lost {
    background-color: rgb(200, 200, 205);
    -unity-background-image-tint-color: rgb(190, 190, 195);
}

.heart.has-icon.heart-lost {
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.35;
}

.pill-points {
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-top: 0;
}

.pill-points.hidden {
    display: none;
}

.player-pill.seat-0 .pill-points { color: rgb(176, 32, 84); }
.player-pill.seat-1 .pill-points { color: rgb(28, 72, 176); }
.player-pill.seat-2 .pill-points { color: rgb(16, 118, 52); }
.player-pill.seat-3 .pill-points { color: rgb(176, 88, 8); }

.player-pill.pill-active {
    opacity: 1;
    scale: 1.06 1.06;
}

.player-pill.pill-out {
    opacity: 0.4;
}

.turn-callout {
    position: absolute;
    left: 50%;
    top: 4px;
    width: 156px;
    height: 156px;
    margin-left: -78px;
    align-items: center;
    justify-content: center;
    background-color: rgb(255, 255, 255);
    border-radius: 78px;
    border-width: 8px;
    border-color: rgb(255, 140, 176);
    transition-property: border-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.turn-callout.hidden {
    display: none;
}

.turn-callout.seat-0 { border-color: rgb(255, 120, 160); }
.turn-callout.seat-1 { border-color: rgb(70, 130, 240); }
.turn-callout.seat-2 { border-color: rgb(70, 190, 100); }
.turn-callout.seat-3 { border-color: rgb(255, 160, 50); }

.timer-ring {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    bottom: 10px;
}

.timer-box {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.hud-round {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(90, 70, 90);
    -unity-text-align: middle-center;
    margin-bottom: 0;
}

.timer-row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.hud-timer {
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(28, 22, 36);
}

.timer-unit {
    margin-left: 2px;
    margin-bottom: 8px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(40, 32, 48);
}

.timer-unit.hidden {
    display: none;
}

.hud-turn {
    margin-top: -2px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(50, 42, 60);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.turn-callout.seat-0 .hud-turn { color: rgb(176, 32, 84); }
.turn-callout.seat-1 .hud-turn { color: rgb(28, 72, 176); }
.turn-callout.seat-2 .hud-turn { color: rgb(16, 118, 52); }
.turn-callout.seat-3 .hud-turn { color: rgb(176, 88, 8); }

.timer-box.timer-urgent .hud-timer,
.timer-box.timer-urgent .timer-unit {
    color: rgb(214, 32, 48);
}

.timer-box.timer-idle .hud-timer {
    color: rgb(120, 110, 124);
}

.turn-yield {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 42px;
    bottom: 42px;
    border-radius: 18px;
    border-width: 3px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    background-color: rgb(255, 236, 168);
    color: rgb(70, 42, 8);
}

.turn-yield.hidden {
    display: none;
}

.turn-yield.yield-pass {
    background-color: rgb(255, 236, 168);
    color: rgb(70, 42, 8);
}

.turn-yield.yield-time {
    background-color: rgb(214, 32, 48);
    color: rgb(255, 255, 255);
}

.turn-yield.yield-cutoff {
    background-color: rgb(36, 48, 72);
    color: rgb(232, 240, 255);
}

.turn-yield.seat-0 { border-color: rgb(255, 120, 160); }
.turn-yield.seat-1 { border-color: rgb(70, 130, 240); }
.turn-yield.seat-2 { border-color: rgb(70, 190, 100); }
.turn-yield.seat-3 { border-color: rgb(255, 160, 50); }

.pass-hint {
    position: absolute;
    left: 0;
    right: 0;
    top: 166px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(40, 32, 48);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.pass-hint.hidden {
    display: none;
}

.hud-menu-button {
    position: absolute;
    left: 3%;
    bottom: 4.5%;
    width: 156px;
    height: 58px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.hud-menu-label {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(230, 70, 120);
    -unity-text-align: middle-center;
}

.hud-menu-button.hidden {
    display: none;
}

.action-chip {
    position: absolute;
    right: 3%;
    bottom: 4.5%;
    width: 156px;
    height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.action-chip.hidden {
    display: none;
}

.action-chip:disabled {
    opacity: 0.4;
}

.action-label {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(230, 70, 120);
}

.pass-marks {
    margin-left: 8px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 70, 120);
}

.action-icon {
    display: none;
    width: 26px;
    height: 26px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.action-icon.has-icon {
    display: flex;
}

.hand-dock {
    position: absolute;
    left: 16%;
    right: 16%;
    bottom: 12%;
    align-items: center;
}

.hand-dock.hidden {
    display: none;
}

.hand-title {
    display: none;
}

.hand-row {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    padding-top: 48px;
    padding-bottom: 6px;
}

.hand-row.hidden {
    display: none;
}

.hand-card {
    width: 112px;
    height: 158px;
    min-width: 112px;
    max-width: 112px;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
    transform-origin: 50% 100%;
    transition-property: scale, translate, rotate, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.hand-card:hover,
.hand-card.hand-card-selected {
    scale: 1.1 1.1;
    border-width: 4px;
    border-color: rgb(255, 252, 248);
}

.hand-card:active {
    scale: 0.98 0.98;
}

.pause-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.pause-overlay.hidden {
    display: none;
}

.hud-root.paused .hand-dock {
    display: none;
}

.pause-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(28, 20, 36, 0.28);
}

.pause-card {
    width: 640px;
    max-width: 86%;
    padding: 26px 32px 22px 32px;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0);
}

.pause-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(176, 32, 84);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.pause-copy {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(50, 42, 60);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.pause-seats {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(40, 32, 48);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 6px;
    margin-bottom: 8px;
}

.pause-options {
    color: rgb(90, 70, 90);
}

.pause-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 16px;
}

.pause-button {
    height: 58px;
    min-width: 180px;
    margin: 0 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.pause-button-label {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause-continue .pause-button-label {
    color: rgb(255, 255, 255);
}

.pause-main .pause-button-label {
    color: rgb(176, 32, 84);
}

.praise-scrap {
    border-radius: 2px;
    border-bottom-right-radius: 8px;
    border-top-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.92);
}

.match-end {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.match-end.hidden { display: none; }

.match-end-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(28, 20, 36, 0.38);
}

.match-end-card {
    width: 70%;
    max-width: 920px;
    min-width: 560px;
    padding: 0 0 28px 0;
    align-items: center;
    background-color: rgba(255, 250, 236, 0.97);
    border-radius: 28px;
    border-width: 12px;
    border-color: rgb(120, 110, 130);
}

.match-end-card.seat-0 { border-color: rgb(255, 120, 160); }
.match-end-card.seat-1 { border-color: rgb(70, 130, 240); }
.match-end-card.seat-2 { border-color: rgb(70, 190, 100); }
.match-end-card.seat-3 { border-color: rgb(255, 160, 50); }

.result-seat-bar {
    width: 100%;
    height: 16px;
    margin-bottom: 16px;
    background-color: rgb(176, 166, 184);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}

.match-end-card.seat-0 .result-seat-bar { height: 44px; background-color: rgb(255, 120, 160); }
.match-end-card.seat-1 .result-seat-bar { height: 44px; background-color: rgb(70, 130, 240); }
.match-end-card.seat-2 .result-seat-bar { height: 44px; background-color: rgb(70, 190, 100); }
.match-end-card.seat-3 .result-seat-bar { height: 44px; background-color: rgb(255, 160, 50); }

.result-kicker {
    margin-top: 4px;
    margin-bottom: 4px;
    margin-left: 40px;
    margin-right: 40px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(120, 110, 130);
}

.result-text {
    margin-left: 40px;
    margin-right: 40px;
    font-size: 88px;
    -unity-font-style: bold;
    color: rgb(70, 60, 80);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.result-summary {
    margin-top: 10px;
    margin-left: 40px;
    margin-right: 40px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(70, 60, 80);
    -unity-text-align: middle-center;
    white-space: normal;
}

.result-xp {
    margin-top: 6px;
    margin-left: 40px;
    margin-right: 40px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(120, 90, 40);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.match-end-card.seat-0 .result-kicker,
.match-end-card.seat-0 .result-text { color: rgb(176, 32, 84); }
.match-end-card.seat-1 .result-kicker,
.match-end-card.seat-1 .result-text { color: rgb(28, 72, 176); }
.match-end-card.seat-2 .result-kicker,
.match-end-card.seat-2 .result-text { color: rgb(16, 118, 52); }
.match-end-card.seat-3 .result-kicker,
.match-end-card.seat-3 .result-text { color: rgb(176, 88, 8); }

.match-end-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 22px;
    margin-left: 40px;
    margin-right: 40px;
}

.match-end-button {
    height: 68px;
    margin: 0 8px;
    -unity-font-style: bold;
    border-radius: 18px;
    border-width: 4px;
    white-space: nowrap;
}

.match-end-button.match-end-primary {
    min-width: 240px;
    font-size: 28px;
    color: rgb(255, 255, 255);
    background-color: rgb(40, 32, 48);
    border-color: rgb(40, 32, 48);
}

.match-end-button.match-end-secondary {
    min-width: 200px;
    font-size: 22px;
    color: rgb(40, 32, 48);
    background-color: rgba(255, 250, 236, 0);
    border-color: rgb(40, 32, 48);
}

.turn-announce {
    position: absolute;
    left: 0;
    right: 0;
    top: 34%;
    align-items: center;
    justify-content: center;
}

.turn-announce.hidden {
    display: none;
}

.turn-announce-line {
    font-size: 72px;
    -unity-font-style: bold;
    color: rgb(50, 42, 60);
    background-color: rgba(255, 252, 248, 0.96);
    border-radius: 28px;
    border-width: 8px;
    border-color: rgb(180, 170, 184);
    padding: 12px 36px;
    white-space: nowrap;
}

.turn-announce.seat-0 .turn-announce-line {
    color: rgb(176, 32, 84);
    border-color: rgb(255, 120, 160);
}

.turn-announce.seat-1 .turn-announce-line {
    color: rgb(28, 72, 176);
    border-color: rgb(70, 130, 240);
}

.turn-announce.seat-2 .turn-announce-line {
    color: rgb(16, 118, 52);
    border-color: rgb(70, 190, 100);
}

.turn-announce.seat-3 .turn-announce-line {
    color: rgb(176, 88, 8);
    border-color: rgb(255, 160, 50);
}

.card-cutin {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.card-cutin.hidden {
    display: none;
}

.card-cutin-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 12, 22, 0.55);
}

.card-cutin-banner {
    flex-direction: row;
    align-items: center;
    min-width: 640px;
    max-width: 92%;
    min-height: 220px;
    padding: 18px 40px 18px 22px;
    background-color: rgba(255, 252, 248, 0.98);
    border-radius: 28px;
    border-width: 8px;
    border-color: rgb(40, 32, 48);
    rotate: -6deg;
}

.card-cutin-banner.seat-0 { border-color: rgb(255, 120, 160); }
.card-cutin-banner.seat-1 { border-color: rgb(70, 130, 240); }
.card-cutin-banner.seat-2 { border-color: rgb(70, 190, 100); }
.card-cutin-banner.seat-3 { border-color: rgb(255, 160, 50); }

.card-cutin-banner.seat-0 .card-cutin-name { color: rgb(176, 32, 84); }
.card-cutin-banner.seat-1 .card-cutin-name { color: rgb(28, 72, 176); }
.card-cutin-banner.seat-2 .card-cutin-name { color: rgb(16, 118, 52); }
.card-cutin-banner.seat-3 .card-cutin-name { color: rgb(176, 88, 8); }

.card-cutin.card-cutin-signature .card-cutin-banner {
    min-height: 260px;
    background-color: rgb(28, 34, 52);
    border-color: rgb(232, 184, 72);
}

.card-cutin.card-cutin-signature .card-cutin-kicker {
    color: rgb(232, 184, 72);
}

.card-cutin.card-cutin-signature .card-cutin-name {
    color: rgb(255, 246, 220);
    font-size: 72px;
}

.card-cutin-face {
    width: 168px;
    height: 220px;
    margin-right: 28px;
    flex-shrink: 0;
}

.card-cutin-face .card-face-body {
    display: none;
}

.card-cutin-face .card-effect-icon {
    width: 88px;
    height: 88px;
    top: 66px;
    left: 40px;
    right: auto;
}

.card-cutin-face .card-ribbon {
    top: 164px;
}

.card-cutin-copy {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.card-cutin-kicker {
    margin: 0 0 4px 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(80, 70, 88);
}

.card-cutin-name {
    margin: 0;
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(28, 22, 36);
    white-space: normal;
}

.cb-seats .pill-name,
.cb-seats .hand-title {
    color: rgb(28, 18, 24);
}

.cb-seats .turn-callout.seat-0 { border-color: rgb(100, 143, 255); }
.cb-seats .turn-callout.seat-1 { border-color: rgb(220, 38, 127); }
.cb-seats .turn-callout.seat-2 { border-color: rgb(254, 97, 0); }
.cb-seats .turn-callout.seat-3 { border-color: rgb(255, 176, 0); }

.cb-seats .turn-callout.seat-0 .hud-turn { color: rgb(20, 52, 160); }
.cb-seats .turn-callout.seat-1 .hud-turn { color: rgb(140, 16, 78); }
.cb-seats .turn-callout.seat-2 .hud-turn { color: rgb(168, 56, 0); }
.cb-seats .turn-callout.seat-3 .hud-turn { color: rgb(130, 84, 0); }

.cb-seats .turn-yield.seat-0 { border-color: rgb(100, 143, 255); }
.cb-seats .turn-yield.seat-1 { border-color: rgb(220, 38, 127); }
.cb-seats .turn-yield.seat-2 { border-color: rgb(254, 97, 0); }
.cb-seats .turn-yield.seat-3 { border-color: rgb(255, 176, 0); }

.cb-seats .player-pill.seat-0 { border-color: rgb(100, 143, 255); }
.cb-seats .player-pill.seat-1 { border-color: rgb(220, 38, 127); }
.cb-seats .player-pill.seat-2 { border-color: rgb(254, 97, 0); }
.cb-seats .player-pill.seat-3 { border-color: rgb(255, 176, 0); }

.cb-seats .seat-0 .pill-name { background-color: rgb(100, 143, 255); }
.cb-seats .seat-1 .pill-name { background-color: rgb(220, 38, 127); }
.cb-seats .seat-2 .pill-name { background-color: rgb(254, 97, 0); }
.cb-seats .seat-3 .pill-name { background-color: rgb(255, 176, 0); }

.cb-seats .player-pill.seat-0 .pill-points { color: rgb(20, 52, 160); }
.cb-seats .player-pill.seat-1 .pill-points { color: rgb(140, 16, 78); }
.cb-seats .player-pill.seat-2 .pill-points { color: rgb(168, 56, 0); }
.cb-seats .player-pill.seat-3 .pill-points { color: rgb(130, 84, 0); }

.cb-seats .match-end-card.seat-0 { border-color: rgb(100, 143, 255); }
.cb-seats .match-end-card.seat-1 { border-color: rgb(220, 38, 127); }
.cb-seats .match-end-card.seat-2 { border-color: rgb(254, 97, 0); }
.cb-seats .match-end-card.seat-3 { border-color: rgb(255, 176, 0); }

.cb-seats .match-end-card.seat-0 .result-seat-bar { background-color: rgb(100, 143, 255); }
.cb-seats .match-end-card.seat-1 .result-seat-bar { background-color: rgb(220, 38, 127); }
.cb-seats .match-end-card.seat-2 .result-seat-bar { background-color: rgb(254, 97, 0); }
.cb-seats .match-end-card.seat-3 .result-seat-bar { background-color: rgb(255, 176, 0); }

.cb-seats .match-end-card.seat-0 .result-kicker,
.cb-seats .match-end-card.seat-0 .result-text { color: rgb(20, 52, 160); }
.cb-seats .match-end-card.seat-1 .result-kicker,
.cb-seats .match-end-card.seat-1 .result-text { color: rgb(140, 16, 78); }
.cb-seats .match-end-card.seat-2 .result-kicker,
.cb-seats .match-end-card.seat-2 .result-text { color: rgb(168, 56, 0); }
.cb-seats .match-end-card.seat-3 .result-kicker,
.cb-seats .match-end-card.seat-3 .result-text { color: rgb(130, 84, 0); }

.cb-seats .hand-dock.seat-0 .hand-title { background-color: rgb(100, 143, 255); }
.cb-seats .hand-dock.seat-1 .hand-title { background-color: rgb(220, 38, 127); }
.cb-seats .hand-dock.seat-2 .hand-title { background-color: rgb(254, 97, 0); }
.cb-seats .hand-dock.seat-3 .hand-title { background-color: rgb(255, 176, 0); }

.cb-seats .turn-announce.seat-0 .turn-announce-line {
    color: rgb(20, 52, 160);
    border-color: rgb(100, 143, 255);
}

.cb-seats .turn-announce.seat-1 .turn-announce-line {
    color: rgb(140, 16, 78);
    border-color: rgb(220, 38, 127);
}

.cb-seats .turn-announce.seat-2 .turn-announce-line {
    color: rgb(168, 56, 0);
    border-color: rgb(254, 97, 0);
}

.cb-seats .turn-announce.seat-3 .turn-announce-line {
    color: rgb(130, 84, 0);
    border-color: rgb(255, 176, 0);
}

.cb-seats .card-cutin-banner.seat-0 { border-color: rgb(100, 143, 255); }
.cb-seats .card-cutin-banner.seat-1 { border-color: rgb(220, 38, 127); }
.cb-seats .card-cutin-banner.seat-2 { border-color: rgb(254, 97, 0); }
.cb-seats .card-cutin-banner.seat-3 { border-color: rgb(255, 176, 0); }

.cb-seats .card-cutin-banner.seat-0 .card-cutin-name { color: rgb(20, 52, 160); }
.cb-seats .card-cutin-banner.seat-1 .card-cutin-name { color: rgb(140, 16, 78); }
.cb-seats .card-cutin-banner.seat-2 .card-cutin-name { color: rgb(168, 56, 0); }
.cb-seats .card-cutin-banner.seat-3 .card-cutin-name { color: rgb(130, 84, 0); }
