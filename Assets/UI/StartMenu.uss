.root {
    flex-grow: 1;
    align-items: stretch;
}

.backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 28, 48, 0.3);
}

.menu-content {
    flex-grow: 1;
    align-items: center;
    padding: 3% 4% 3% 4%;
}

.brand-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.brand-icon {
    width: 150px;
    height: 150px;
    margin-left: 12px;
}

.brand-text {
    flex-direction: column;
    align-items: center;
}

.title-ja {
    font-size: 88px;
    -unity-font-style: bold;
    color: rgb(255, 90, 140);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(255, 255, 255);
    text-shadow: 0 4px 0 rgb(60, 24, 44);
    margin: 0;
    padding: 0;
}

.title-en {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(70, 40, 30);
    letter-spacing: 4px;
    margin: 0;
    padding: 0;
}

.spacer {
    flex-grow: 1;
}

.cta-button {
    width: 46%;
    min-width: 420px;
    height: 112px;
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 50, 110);
    background-color: rgb(52, 130, 235);
    border-radius: 56px;
    border-width: 6px;
    border-color: rgb(30, 36, 60);
    margin: 0 0 28px 0;
}

.cta-button:hover {
    background-color: rgb(90, 160, 255);
}

.cta-button:active {
    background-color: rgb(36, 100, 200);
}

.tile-row {
    flex-direction: row;
    width: 100%;
    max-width: 1200px;
    justify-content: center;
}

.tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 150px;
    margin: 0 8px;
    padding: 8px;
    background-color: rgb(255, 252, 244);
    border-radius: 18px;
    border-width: 4px;
    align-items: center;
    justify-content: center;
}

.tile-pink {
    border-color: rgb(250, 170, 190);
}

.tile-yellow {
    border-color: rgb(240, 214, 140);
}

.tile-blue {
    border-color: rgb(150, 200, 240);
}

.tile:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 120, 150);
}

.tile.selected {
    background-color: rgb(255, 238, 176);
    border-color: rgb(40, 40, 48);
}

.tile-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
}

.tile-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(40, 36, 48);
    white-space: normal;
    -unity-text-align: middle-center;
}

.side-panel {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 280px;
    padding: 18px;
    background-color: rgba(20, 24, 36, 0.94);
    border-radius: 12px;
    border-top-width: 4px;
    border-top-color: rgb(255, 200, 64);
}

.side-panel.hidden {
    display: none;
}

.panel-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

.panel-body {
    font-size: 14px;
    color: rgb(220, 220, 230);
    white-space: normal;
    margin-bottom: 14px;
}

.panel-close {
    height: 40px;
    font-size: 16px;
    -unity-font-style: bold;
}
