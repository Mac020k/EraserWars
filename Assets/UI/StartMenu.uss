.root {
    flex-grow: 1;
    align-items: stretch;
}

.backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 28, 48, 0.28);
}

.menu-content {
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
    padding: 4% 5% 3% 5%;
    max-height: 100%;
}

.brand-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.brand-icon {
    width: 72px;
    height: 72px;
    margin-left: 10px;
    flex-shrink: 0;
}

.brand-text {
    flex-direction: column;
    align-items: center;
}

.title-ja {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 90, 140);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(255, 255, 255);
    text-shadow: 0 3px 0 rgb(60, 24, 44);
    margin: 0;
    padding: 0;
}

.title-en {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(70, 40, 30);
    letter-spacing: 3px;
    margin: 0;
    padding: 0;
}

.spacer {
    flex-grow: 1;
    min-height: 8px;
    max-height: 48px;
}

.cta-button {
    width: 42%;
    min-width: 280px;
    max-width: 520px;
    height: 64px;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 50, 110);
    background-color: rgb(52, 130, 235);
    border-radius: 32px;
    border-width: 4px;
    border-color: rgb(30, 36, 60);
    margin: 0 0 16px 0;
    flex-shrink: 0;
}

.cta-button:hover {
    background-color: rgb(90, 160, 255);
}

.cta-button:active {
    background-color: rgb(36, 100, 200);
}

.tile-row {
    flex-direction: row;
    width: 100%;
    max-width: 900px;
    justify-content: center;
    flex-shrink: 0;
}

.tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 96px;
    margin: 0 6px;
    padding: 6px;
    background-color: rgb(255, 252, 244);
    border-radius: 14px;
    border-width: 3px;
    align-items: center;
    justify-content: center;
}

.tile-pink {
    border-color: rgb(250, 170, 190);
}

.tile-yellow {
    border-color: rgb(240, 214, 140);
}

.tile-blue {
    border-color: rgb(150, 200, 240);
}

.tile:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 120, 150);
}

.tile.selected {
    background-color: rgb(255, 238, 176);
    border-color: rgb(40, 40, 48);
}

.tile-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 4px;
}

.tile-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(40, 36, 48);
    white-space: normal;
    -unity-text-align: middle-center;
}

.side-panel {
    position: absolute;
    right: 20px;
    top: 20px;
    width: 260px;
    padding: 16px;
    background-color: rgba(20, 24, 36, 0.94);
    border-radius: 12px;
    border-top-width: 4px;
    border-top-color: rgb(255, 200, 64);
}

.side-panel.hidden {
    display: none;
}

.panel-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

.panel-body {
    font-size: 13px;
    color: rgb(220, 220, 230);
    white-space: normal;
    margin-bottom: 12px;
}

.panel-close {
    height: 36px;
    font-size: 15px;
    -unity-font-style: bold;
}
