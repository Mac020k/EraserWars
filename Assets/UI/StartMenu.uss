.root {
    flex-grow: 1;
    align-items: stretch;
    width: 100%;
    height: 100%;
}

.backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 28, 48, 0.28);
}

.menu-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 3% 4% 2.5% 4%;
    max-height: 100%;
}

.brand-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 1;
    max-height: 18%;
}

.brand-icon {
    width: 56px;
    height: 56px;
    margin-left: 1%;
    flex-shrink: 0;
}

.brand-text {
    flex-direction: column;
    align-items: center;
    flex-shrink: 1;
}

.title-ja {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(255, 90, 140);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(255, 255, 255);
    text-shadow: 0 3px 0 rgb(60, 24, 44);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.title-en {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(70, 40, 30);
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
}

.spacer {
    flex-grow: 1;
    min-height: 2%;
    max-height: 8%;
}

.cta-button {
    width: 34%;
    min-width: 180px;
    max-width: 480px;
    height: 52px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 50, 110);
    background-color: rgb(52, 130, 235);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(30, 36, 60);
    margin: 0 0 1.5% 0;
    flex-shrink: 0;
}

.cta-button:hover {
    background-color: rgb(90, 160, 255);
}

.cta-button:active {
    background-color: rgb(36, 100, 200);
}

.cta-resume {
    background-color: rgb(70, 190, 100);
    -unity-text-outline-color: rgb(20, 70, 40);
    border-color: rgb(30, 80, 45);
}

.cta-resume:hover {
    background-color: rgb(90, 210, 120);
}

.cta-resume:active {
    background-color: rgb(50, 160, 80);
}

.tile-row {
    flex-direction: row;
    width: 92%;
    max-width: 1100px;
    height: 88px;
    justify-content: center;
    flex-shrink: 0;
}

.tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 100%;
    margin: 0 0.5%;
    padding: 6px;
    background-color: rgb(255, 252, 244);
    border-radius: 12px;
    border-width: 3px;
    align-items: center;
    justify-content: center;
}

.tile-pink {
    border-color: rgb(250, 170, 190);
}

.tile-yellow {
    border-color: rgb(240, 214, 140);
}

.tile-blue {
    border-color: rgb(150, 200, 240);
}

.tile:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 120, 150);
}

.tile.selected {
    background-color: rgb(255, 238, 176);
    border-color: rgb(40, 40, 48);
}

.tile-icon {
    width: 36%;
    height: 42%;
    min-width: 28px;
    max-width: 48px;
    min-height: 28px;
    max-height: 48px;
    margin-bottom: 2%;
}

.tile-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(40, 36, 48);
    white-space: normal;
    -unity-text-align: middle-center;
}

.side-panel {
    position: absolute;
    right: 2%;
    top: 3%;
    width: 22%;
    min-width: 200px;
    max-width: 320px;
    padding: 1.2%;
    background-color: rgba(20, 24, 36, 0.94);
    border-radius: 12px;
    border-top-width: 4px;
    border-top-color: rgb(255, 200, 64);
}

.hidden {
    display: none;
}

.side-panel.hidden {
    display: none;
}

.panel-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

.panel-body {
    font-size: 13px;
    color: rgb(220, 220, 230);
    white-space: normal;
    margin-bottom: 12px;
}

.panel-close {
    height: 36px;
    font-size: 15px;
    -unity-font-style: bold;
}
