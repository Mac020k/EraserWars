.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 28, 48, 0.72);
}

.center-card {
    width: 560px;
    max-width: 90%;
    padding: 28px 32px 24px 32px;
    background-color: rgba(255, 248, 235, 0.96);
    border-radius: 18px;
    border-top-width: 6px;
    border-top-color: rgb(255, 92, 64);
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(40, 40, 48);
    border-right-color: rgb(40, 40, 48);
    border-bottom-color: rgb(40, 40, 48);
    align-items: center;
}

.brand-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.brand-icon {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    background-color: rgb(255, 120, 90);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(40, 40, 48);
}

.brand-text {
    flex-direction: column;
}

.title-ja {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(32, 28, 40);
    margin: 0;
    padding: 0;
}

.title-en {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 92, 64);
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
}

.tagline {
    font-size: 15px;
    color: rgb(70, 70, 82);
    margin-bottom: 18px;
}

.cta-button {
    width: 100%;
    height: 64px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(255, 72, 88);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(40, 40, 48);
    margin-bottom: 16px;
}

.cta-button:hover {
    background-color: rgb(255, 110, 70);
}

.mode-row {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    margin-bottom: 12px;
}

.mode-button {
    flex-grow: 1;
    height: 88px;
    margin: 0 6px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(40, 40, 48);
    align-items: center;
    justify-content: center;
}

.mode-button.selected {
    background-color: rgb(255, 230, 120);
}

.mode-icon {
    width: 36px;
    height: 36px;
    margin-bottom: 4px;
    background-color: rgb(80, 140, 255);
    border-radius: 8px;
}

.mode-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(32, 28, 40);
}

.utility-row {
    flex-direction: row;
    width: 100%;
    justify-content: center;
    margin-top: 4px;
}

.utility-button {
    width: 120px;
    height: 72px;
    margin: 0 8px;
    background-color: rgb(245, 245, 250);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(40, 40, 48);
    align-items: center;
    justify-content: center;
}

.utility-icon {
    width: 28px;
    height: 28px;
    margin-bottom: 4px;
    background-color: rgb(90, 200, 120);
    border-radius: 6px;
}

.utility-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(40, 40, 48);
}

.side-panel {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 280px;
    padding: 18px;
    background-color: rgba(20, 24, 36, 0.94);
    border-radius: 12px;
    border-top-width: 4px;
    border-top-color: rgb(255, 200, 64);
}

.side-panel.hidden {
    display: none;
}

.panel-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

.panel-body {
    font-size: 14px;
    color: rgb(220, 220, 230);
    white-space: normal;
    margin-bottom: 14px;
}

.panel-close {
    height: 40px;
    font-size: 16px;
    -unity-font-style: bold;
}
