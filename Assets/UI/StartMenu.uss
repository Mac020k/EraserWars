@import url("CardFace.uss");

.root {
    position: relative;
    flex-grow: 1;
    align-items: stretch;
    width: 100%;
    height: 100%;
}

.backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 28, 48, 0.28);
}

.menu-content {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    align-items: stretch;
    justify-content: flex-start;
    padding: 0;
}

.home-stack {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 3% 4% 2.5% 4%;
}

.home-stack.hidden {
    display: none;
}

.brand-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 1;
    max-height: 18%;
}

.brand-icon {
    width: 56px;
    height: 56px;
    margin-left: 1%;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.brand-text {
    flex-direction: column;
    align-items: center;
    flex-shrink: 1;
}

.title-ja {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(255, 90, 140);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(255, 255, 255);
    text-shadow: 0 3px 0 rgb(60, 24, 44);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.title-en {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(70, 40, 30);
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
}

.spacer {
    flex-grow: 1;
    min-height: 2%;
    max-height: 12%;
}

.action-stack {
    width: 42%;
    min-width: 280px;
    max-width: 520px;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 1.5%;
}

.mode-segment {
    flex-direction: row;
    width: 100%;
    height: 48px;
    margin-bottom: 14px;
    padding: 4px;
    background-color: rgb(255, 252, 244);
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(40, 40, 48);
}

.mode-chip {
    flex-grow: 1;
    height: 100%;
    margin: 0 2px;
    padding: 0 8px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(48, 44, 56);
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
}

.mode-chip:hover {
    background-color: rgba(255, 200, 120, 0.35);
}

.mode-chip.selected {
    background-color: rgb(245, 168, 66);
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(120, 70, 20);
}

.cta-button {
    width: 100%;
    min-width: 180px;
    max-width: 520px;
    height: 58px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 50, 110);
    background-color: rgb(52, 130, 235);
    border-radius: 29px;
    border-width: 3px;
    border-color: rgb(30, 36, 60);
    margin: 0;
    flex-shrink: 0;
}

.cta-button:hover {
    background-color: rgb(90, 160, 255);
}

.cta-button:active {
    background-color: rgb(36, 100, 200);
}

.secret-room-entry {
    width: 100%;
    height: 40px;
    margin-top: 10px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(48, 44, 56);
    background-color: rgb(255, 252, 244);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(196, 150, 88);
    flex-shrink: 0;
}

.cta-resume {
    background-color: rgb(70, 190, 100);
    -unity-text-outline-color: rgb(20, 70, 40);
    border-color: rgb(30, 80, 45);
}

.cta-resume:hover {
    background-color: rgb(90, 210, 120);
}

.cta-resume:active {
    background-color: rgb(50, 160, 80);
}

.home-tip {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
    padding: 8px 10px 8px 14px;
    background-color: rgb(255, 248, 230);
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(40, 40, 48);
    flex-shrink: 0;
}

.home-tip-copy {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(48, 44, 56);
    white-space: normal;
}

.home-tip-dismiss {
    height: 36px;
    min-width: 72px;
    margin-left: 8px;
    padding: 0 10px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(48, 44, 56);
    background-color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(40, 40, 48);
    flex-shrink: 0;
}

.nav-row {
    flex-direction: row;
    width: 58%;
    min-width: 360px;
    max-width: 720px;
    height: 92px;
    justify-content: center;
    flex-shrink: 0;
}

.nav-tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 100%;
    margin: 0 8px;
    padding: 8px 6px 6px 6px;
    background-color: rgb(255, 252, 244);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(210, 200, 180);
    align-items: center;
    justify-content: center;
}

.nav-tile:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 140, 100);
}

.nav-tile:active {
    background-color: rgb(255, 238, 210);
}

.tile-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 4px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.tile-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(40, 36, 48);
    white-space: normal;
    -unity-text-align: middle-center;
}

.destination-page {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 4%;
    bottom: 4%;
    padding: 20px 24px;
    background-color: rgb(18, 22, 40);
    flex-direction: column;
    border-width: 8px;
    border-color: rgb(196, 150, 88);
    border-radius: 6px;
    overflow: hidden;
}

.collection-panel.destination-page {
    background-color: rgb(42, 98, 62);
    border-color: rgb(210, 168, 104);
}

.options-panel.destination-page {
    background-color: rgb(32, 38, 58);
    border-color: rgb(170, 180, 210);
}

.secret-room-panel.destination-page {
    background-color: rgb(41, 26, 71);
    border-color: rgb(196, 150, 88);
}

.secret-room-code {
    height: 56px;
    min-height: 56px;
    margin: 8px 0 12px 0;
    background-color: rgb(255, 252, 244);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(40, 40, 48);
}

.secret-room-code,
.secret-room-code .unity-text-element {
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    color: rgb(40, 36, 48);
}

.secret-room-code .unity-base-field__label {
    display: none;
}

.secret-room-actions {
    flex-direction: row;
    height: 48px;
    margin: 4px 0 8px 0;
}

.destination-page.hidden {
    display: none;
}

.destination-chrome {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.destination-back {
    width: 110px;
    height: 36px;
    margin-right: 12px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgb(255, 252, 244);
    color: rgb(40, 36, 48);
    border-radius: 8px;
}

.destination-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.options-body {
    width: 100%;
    flex-grow: 1;
    max-width: none;
    padding: 8px 16px 16px 16px;
    background-color: rgba(8, 10, 18, 0.35);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
}

.options-scroll {
    flex-grow: 1;
    min-height: 0;
}

.options-panel .options-back {
    width: 132px;
    height: 48px;
    min-height: 48px;
    font-size: 16px;
}

.options-section {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin: 18px 0 2px 0;
}

.options-section-first {
    margin-top: 4px;
}

.options-label {
    font-size: 16px;
    color: rgb(255, 220, 120);
    margin: 10px 0 2px 0;
}

.options-note {
    font-size: 14px;
    color: rgb(210, 214, 226);
    white-space: normal;
    margin: 2px 0 8px 0;
}

.options-slider {
    height: 48px;
    min-height: 48px;
    margin: 0 0 6px 0;
}

.options-slider .unity-base-slider__drag-container {
    height: 48px;
}

.options-slider .unity-base-slider__dragger {
    width: 28px;
    height: 28px;
}

.options-choice-row {
    flex-direction: row;
    height: 48px;
    margin: 4px 0 8px 0;
}

.options-choice {
    flex-grow: 1;
    height: 48px;
    min-height: 48px;
    margin: 0 4px;
    font-size: 18px;
    -unity-font-style: bold;
    background-color: rgb(60, 66, 84);
    color: rgb(230, 230, 240);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(100, 110, 130);
}

.options-choice.selected {
    background-color: rgb(245, 168, 66);
    color: rgb(255, 255, 255);
    border-color: rgb(120, 70, 20);
}

.options-debug-button,
.options-toggle,
.options-reset {
    height: 48px;
    min-height: 48px;
    margin-top: 4px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgb(60, 66, 84);
    color: rgb(230, 230, 240);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(100, 110, 130);
}

.options-debug-button.debug-on,
.options-toggle.on {
    background-color: rgb(70, 160, 90);
    border-color: rgb(30, 80, 45);
    color: rgb(255, 255, 255);
}

.options-swatches {
    flex-direction: row;
    height: 28px;
    margin: 8px 0 4px 0;
}

.options-swatch {
    flex-grow: 1;
    height: 28px;
    margin: 0 4px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(40, 40, 48);
}

.options-reset {
    margin-top: 22px;
    margin-bottom: 12px;
}

.options-reset.armed {
    background-color: rgb(176, 64, 48);
    border-color: rgb(90, 24, 18);
    color: rgb(255, 255, 255);
}

.hidden {
    display: none;
}

.panel-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

.panel-body {
    font-size: 13px;
    color: rgb(220, 220, 230);
    white-space: normal;
    margin-bottom: 12px;
}

.panel-close {
    height: 36px;
    font-size: 15px;
    -unity-font-style: bold;
}

.collection-tabs {
    flex-direction: row;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.collection-tab {
    flex-grow: 1;
    height: 44px;
    margin-right: 8px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgb(40, 46, 64);
    color: rgb(230, 230, 240);
    border-width: 1px;
    border-color: rgb(80, 88, 110);
    border-radius: 8px;
}

.collection-tab.selected {
    background-color: rgb(255, 210, 80);
    color: rgb(30, 28, 36);
    border-color: rgb(40, 40, 48);
}

.collection-filters {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.collection-filter {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 36px;
    min-width: 64px;
    margin: 0 6px 6px 0;
    padding: 0 12px;
    font-size: 13px;
    background-color: rgb(48, 54, 72);
    color: rgb(220, 220, 230);
    border-width: 1px;
    border-color: rgb(90, 96, 120);
    border-radius: 6px;
}

.collection-filter.selected {
    background-color: rgb(90, 160, 255);
    color: rgb(255, 255, 255);
    border-color: rgb(30, 60, 120);
}

.collection-strip-scroll {
    height: 268px;
    flex-shrink: 0;
    margin-bottom: 12px;
    background-color: rgba(12, 22, 16, 0.45);
    border-radius: 12px;
    padding: 8px 8px 4px 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
}

.collection-strip {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    overflow: visible;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 10px;
    padding-right: 10px;
}

.char-tile {
    width: 118px;
    height: 176px;
    margin-right: 10px;
    flex-shrink: 0;
    padding: 8px;
    flex-direction: column;
    align-items: center;
    background-color: rgb(255, 252, 244);
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(255, 170, 120);
    transition-property: scale, border-color, background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.char-tile.unlock-flash {
    scale: 1.08 1.08;
    border-color: rgb(255, 228, 90);
    background-color: rgb(255, 250, 214);
}

.char-tile.unlock-flash .char-tile-art {
    background-color: rgb(255, 236, 160);
    -unity-background-image-tint-color: rgb(255, 236, 160);
}

.char-tile.selected {
    border-color: rgb(255, 210, 64);
    border-width: 4px;
    background-color: rgb(255, 248, 220);
}

.collection-strip .char-tile {
    flex-shrink: 0;
}

.collection-strip .char-tile:hover {
    scale: 1.04 1.04;
    translate: 0 -3px;
}

.collection-strip .char-tile:active {
    scale: 0.98 0.98;
    translate: 0 0;
}

.char-tile.locked {
    background-color: rgb(48, 52, 64);
    border-color: rgb(90, 96, 110);
}

.char-tile-art {
    width: 96px;
    height: 96px;
    margin-bottom: 6px;
    background-color: rgb(210, 216, 230);
    border-radius: 48px;
    overflow: hidden;
    background-size: 280% 280%;
    background-repeat: no-repeat;
    background-position: 50% 8%;
    -unity-background-scale-mode: scale-and-crop;
}

.char-tile .char-tile-art {
    background-size: 520% 520%;
    background-position: 50% 3%;
}

.char-tile.locked .char-tile-art {
    background-color: rgb(28, 30, 40);
}

.char-tile-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(32, 30, 40);
    white-space: normal;
    -unity-text-align: middle-center;
}

.char-tile.locked .char-tile-name {
    color: rgb(200, 200, 210);
}

.char-tile-arch {
    font-size: 11px;
    color: rgb(90, 80, 70);
    margin-top: 2px;
}

.char-tile.locked .char-tile-arch {
    color: rgb(160, 160, 170);
}

.char-tile-arch-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
}

.char-lock {
    width: 36px;
    height: 42px;
    margin-top: 26px;
    margin-left: auto;
    margin-right: auto;
    align-items: center;
}

.char-lock-shackle {
    width: 20px;
    height: 14px;
    border-width: 3px;
    border-bottom-width: 0;
    border-color: rgb(232, 214, 140);
    border-radius: 10px 10px 0 0;
    background-color: rgba(0, 0, 0, 0);
}

.char-lock-body {
    width: 30px;
    height: 22px;
    margin-top: -1px;
    border-radius: 4px;
    background-color: rgb(240, 206, 96);
}

.arch-mark {
    width: 18px;
    height: 18px;
    margin-right: 3px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.arch-diamond {
    width: 10px;
    height: 10px;
    background-color: rgb(255, 84, 64);
    rotate: 45deg;
    border-radius: 1px;
}

.arch-seat-take {
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
}

.arch-chair-back {
    width: 10px;
    height: 7px;
    border-width: 2px;
    border-bottom-width: 0;
    border-color: rgb(90, 160, 255);
    border-radius: 2px 2px 0 0;
}

.arch-chair-seat {
    width: 14px;
    height: 4px;
    background-color: rgb(90, 160, 255);
    border-radius: 1px;
}

.arch-teacher {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.arch-teacher-head {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: rgb(255, 196, 120);
}

.arch-teacher-body {
    width: 12px;
    height: 6px;
    margin-top: 1px;
    border-radius: 3px 3px 1px 1px;
    background-color: rgb(72, 150, 96);
}

.arch-afterschool {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.arch-flask-neck {
    width: 4px;
    height: 5px;
    background-color: rgb(180, 140, 255);
}

.arch-flask-bowl {
    width: 14px;
    height: 9px;
    border-radius: 0 0 7px 7px;
    background-color: rgb(150, 90, 255);
}

.arch-desk-king {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.arch-crown-points {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.arch-crown-point {
    width: 4px;
    height: 8px;
    margin-left: 1px;
    margin-right: 1px;
    background-color: rgb(255, 196, 48);
    border-radius: 2px 2px 0 0;
}

.arch-crown-base {
    width: 16px;
    height: 4px;
    background-color: rgb(255, 176, 32);
    border-radius: 1px;
}

.card-tile {
    width: 120px;
    height: 168px;
    margin-right: 10px;
    flex-shrink: 0;
}

.card-tile:hover {
    scale: 1.04 1.04;
    translate: 0 -6px;
}

.card-tile:active {
    scale: 0.98 0.98;
    translate: 0 0;
}

.collection-feature {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.collection-preview {
    width: 240px;
    flex-shrink: 0;
    margin-right: 14px;
    flex-direction: column;
    align-items: center;
}

.collection-stage {
    width: 220px;
    height: 300px;
    overflow: hidden;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(255, 200, 64);
    background-color: rgba(10, 12, 20, 0.55);
    position: relative;
}

.collection-stage.locked {
    border-color: rgb(80, 84, 96);
    background-color: rgb(24, 26, 34);
}

.collection-portrait {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    border-radius: 16px;
    background-color: rgba(10, 12, 20, 0);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.collection-portrait.locked {
    background-color: rgb(24, 26, 34);
}

.collection-portrait .char-lock {
    position: relative;
    width: 72px;
    height: 84px;
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
}

.collection-portrait .char-lock-shackle {
    width: 36px;
    height: 24px;
    border-width: 5px;
    border-radius: 16px 16px 0 0;
}

.collection-portrait .char-lock-body {
    width: 52px;
    height: 36px;
    border-radius: 6px;
}

.collection-preview-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 14px;
    background-color: rgba(16, 20, 32, 0.96);
    justify-content: center;
}

.collection-preview-kicker {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 220, 120);
    margin-bottom: 8px;
    white-space: normal;
}

.collection-slot-caption {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(236, 236, 244);
    white-space: normal;
    -unity-text-align: middle-center;
}

.collection-preview-modes {
    flex-direction: row;
    margin-top: 8px;
    width: 220px;
}

.collection-preview-mode {
    flex-grow: 1;
    height: 32px;
    margin-right: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    background-color: rgb(40, 46, 64);
    color: rgb(230, 230, 240);
    border-width: 1px;
    border-color: rgb(80, 88, 110);
    border-radius: 6px;
}

.collection-preview-mode.selected {
    background-color: rgb(255, 210, 80);
    color: rgb(30, 28, 36);
    border-color: rgb(40, 40, 48);
}

.collection-detail {
    flex-grow: 1;
    background-color: rgba(10, 12, 20, 0.35);
    border-radius: 8px;
    padding: 12px;
}

.collection-detail-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 4px;
    white-space: normal;
}

.collection-detail-unlock {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(120, 210, 255);
    margin-bottom: 8px;
    white-space: normal;
}

.collection-detail-meta {
    font-size: 13px;
    color: rgb(255, 220, 120);
    white-space: normal;
    margin-bottom: 10px;
}

.collection-detail-body {
    font-size: 14px;
    color: rgb(220, 220, 230);
    white-space: normal;
}

.collection-arch-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.collection-arch-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 220, 120);
}

.collection-subjects {
    flex-direction: row;
    margin-bottom: 8px;
}

.collection-subject-strong {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 214, 96);
    margin-right: 16px;
}

.collection-subject-weak {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(160, 186, 220);
}

.collection-passive {
    font-size: 14px;
    color: rgb(190, 230, 190);
    white-space: normal;
    margin-top: 8px;
}

.collection-signatures {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 10px;
}

.collection-signature {
    width: 120px;
    margin-right: 10px;
    flex-direction: column;
}

.collection-signatures .card-tile {
    width: 108px;
    height: 148px;
    margin-right: 0;
}

.collection-signatures .card-tile:hover,
.collection-signatures .card-tile:active {
    scale: 1 1;
    translate: 0 0;
}

.collection-signature-effect {
    font-size: 12px;
    color: rgb(210, 220, 235);
    white-space: normal;
    margin-top: 4px;
}

.collection-empty {
    color: rgb(180, 180, 190);
    font-size: 13px;
    margin: 8px;
}

.collection-list {
    width: 42%;
    margin-right: 10px;
    background-color: rgba(10, 12, 20, 0.35);
    border-radius: 8px;
    padding: 4px;
}

.collection-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.deck-seats {
    flex-direction: row;
    margin-bottom: 6px;
}

.deck-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    min-width: 0;
    min-height: 0;
}

.deck-column-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(92, 48, 28);
    margin-bottom: 4px;
}

.deck-list {
    width: auto;
    flex-grow: 1;
    min-height: 0;
    margin-right: 0;
}

.deck-item {
    height: 44px;
    margin: 0 0 4px 0;
    padding: 0 8px;
    font-size: 14px;
    -unity-text-align: middle-left;
    background-color: rgb(255, 252, 244);
    color: rgb(32, 30, 40);
    border-width: 1px;
    border-color: rgb(200, 190, 170);
    border-radius: 6px;
}

.deck-item.selected {
    background-color: rgb(255, 230, 140);
    border-color: rgb(40, 40, 48);
}

.deck-budget {
    flex-shrink: 0;
    margin-bottom: 8px;
    padding: 10px 12px;
    background-color: rgb(255, 236, 214);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(232, 160, 176);
}

.deck-budget-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.deck-budget-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(92, 48, 28);
}

.deck-budget-remain {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(140, 72, 28);
}

.deck-budget-remain.full {
    color: rgb(190, 230, 170);
}

.deck-budget-remain.over {
    color: rgb(255, 186, 170);
}

.deck-budget-track {
    height: 12px;
    background-color: rgb(255, 248, 236);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(214, 160, 140);
    overflow: hidden;
}

.deck-budget-fill {
    height: 100%;
    width: 0;
    background-color: rgb(255, 210, 80);
    border-radius: 6px;
}

.deck-budget-fill.full {
    background-color: rgb(120, 190, 110);
}

.deck-budget-fill.over {
    background-color: rgb(214, 84, 68);
}

.deck-budget-warning {
    margin-top: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(160, 40, 36);
    white-space: normal;
}

.deck-save {
    margin-top: 8px;
    height: 44px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgb(232, 104, 140);
    color: rgb(255, 252, 244);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(140, 48, 80);
}

.deck-save:disabled {
    background-color: rgb(90, 86, 96);
    color: rgb(210, 206, 214);
    border-color: rgb(70, 66, 76);
}

.deck-empty {
    flex-shrink: 0;
    margin: 0 0 6px 0;
    font-size: 14px;
    color: rgb(120, 80, 72);
    white-space: normal;
}

.deck-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-width: 360px;
    margin: 0 0 8px 0;
    padding: 8px 6px;
    background-color: rgb(255, 252, 244);
    border-width: 1px;
    border-color: rgb(200, 190, 170);
    border-radius: 12px;
}

.deck-row.deck-row-in {
    background-color: rgb(255, 236, 170);
    border-color: rgb(40, 40, 48);
}

.deck-row .card-tile {
    margin-right: 8px;
    margin-bottom: 0;
    flex-shrink: 0;
}

.deck-row .card-tile:hover,
.deck-row .card-tile:active {
    scale: 1 1;
    translate: 0 0;
}

.deck-row-actions {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    flex-shrink: 0;
}

.deck-row-count {
    flex-shrink: 0;
    margin-right: 2px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(60, 48, 36);
    white-space: nowrap;
}

.deck-action {
    flex-shrink: 0;
    width: 72px;
    height: 44px;
    margin-left: 6px;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 2px;
}

.deck-action-add {
    background-color: rgb(255, 210, 80);
    color: rgb(32, 28, 20);
    border-color: rgb(120, 84, 20);
}

.deck-action-remove {
    background-color: rgb(255, 252, 244);
    color: rgb(90, 32, 28);
    border-color: rgb(180, 90, 80);
}

.deck-panel.destination-page {
    background-color: rgb(176, 122, 74);
    border-color: rgb(112, 68, 36);
    padding: 12px 16px 16px 16px;
}

.deck-panel .destination-title {
    color: rgb(255, 248, 236);
}

.deck-seats .collection-tab {
    flex-grow: 0;
    width: 72px;
    height: 36px;
    background-color: rgb(255, 228, 214);
    color: rgb(92, 48, 28);
    border-width: 2px;
    border-color: rgb(196, 120, 88);
}

.deck-seats .collection-tab.selected {
    background-color: rgb(232, 104, 140);
    color: rgb(255, 252, 244);
    border-color: rgb(140, 48, 80);
}

.deck-binder {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
    background-color: rgb(232, 104, 140);
    border-radius: 18px;
    border-width: 3px;
    border-color: rgb(176, 64, 104);
    padding: 10px 8px;
}

.deck-page {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: rgb(255, 248, 236);
    border-radius: 10px;
    padding: 10px 12px;
}

.deck-spiral {
    width: 22px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: center;
}

.deck-ring {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(214, 122, 58);
    border-width: 2px;
    border-color: rgb(140, 72, 28);
}

.deck-portrait-ring {
    width: 120px;
    height: 120px;
    align-self: center;
    flex-shrink: 0;
    margin-bottom: 6px;
    padding: 6px;
    border-radius: 60px;
    background-color: rgb(255, 214, 228);
    border-width: 4px;
    border-color: rgb(232, 104, 140);
}

.deck-portrait {
    flex-grow: 1;
    border-radius: 52px;
    background-color: rgb(255, 236, 214);
}

.deck-name {
    flex-shrink: 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(92, 48, 28);
    white-space: normal;
    -unity-text-align: middle-center;
}

.deck-archetype {
    flex-shrink: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(196, 72, 112);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.deck-stats {
    flex-shrink: 0;
    margin-bottom: 4px;
    padding: 4px 8px;
    font-size: 13px;
    color: rgb(72, 48, 36);
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: rgb(255, 236, 214);
    border-radius: 8px;
}

.deck-flavor,
.deck-detail,
.deck-status {
    flex-shrink: 0;
    font-size: 12px;
    color: rgb(110, 72, 64);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.deck-status {
    -unity-text-align: middle-left;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(92, 48, 28);
}

.deck-signatures {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: center;
    margin-bottom: 4px;
}

.deck-signatures .card-tile:hover,
.deck-signatures .card-tile:active {
    scale: 1 1;
    translate: 0 0;
}

.deck-page .deck-list {
    background-color: rgba(255, 255, 255, 0.45);
}

.deck-presets {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-bottom: 6px;
}

.deck-preset {
    width: 36px;
    height: 32px;
    margin-right: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgb(255, 236, 214);
    color: rgb(92, 48, 28);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(232, 160, 176);
}

.deck-preset.selected {
    background-color: rgb(232, 104, 140);
    color: rgb(255, 252, 244);
    border-color: rgb(140, 48, 80);
}

.deck-preset-name {
    margin-left: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(92, 48, 28);
    white-space: nowrap;
}

.seat-strip-scroll {
    width: 100%;
    height: 136px;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 6px;
}

.seat-strip {
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-start;
    min-width: 100%;
    justify-content: center;
    overflow: visible;
    padding-top: 6px;
    padding-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
}

.seat-chip {
    flex-grow: 0;
    flex-shrink: 0;
    width: 96px;
    max-width: 96px;
    height: 112px;
    margin: 0 3px;
    padding: 4px 2px 2px 2px;
    flex-direction: column;
    align-items: center;
    background-color: rgb(255, 252, 244);
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(255, 170, 120);
}

.seat-chip.selected {
    border-color: rgb(255, 210, 64);
    border-width: 4px;
    background-color: rgb(255, 248, 220);
}

.seat-chip-tag {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(90, 70, 40);
    margin: 0;
    padding: 0;
}

.seat-chip .char-tile-art {
    width: 44px;
    height: 44px;
    margin-top: 2px;
    margin-bottom: 2px;
    border-radius: 22px;
}

.seat-chip-name {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(32, 30, 40);
    white-space: normal;
    overflow: hidden;
    height: 28px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.seat-picker {
    width: 100%;
    height: 250px;
    margin-bottom: 10px;
    padding: 8px;
    background-color: rgba(12, 22, 16, 0.45);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    overflow: visible;
}

.seat-picker-caption {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 248, 230);
    margin-bottom: 4px;
    -unity-text-align: middle-left;
}

.seat-picker-scroll {
    flex-grow: 1;
    height: 210px;
}

.seat-picker-row {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    overflow: visible;
    min-height: 176px;
    padding-top: 16px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
}
