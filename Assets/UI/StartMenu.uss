.root {
    flex-grow: 1;
    align-items: stretch;
    width: 100%;
    height: 100%;
}

.backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(18, 28, 48, 0.28);
}

.menu-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 3% 4% 2.5% 4%;
    max-height: 100%;
}

.brand-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 1;
    max-height: 18%;
}

.brand-icon {
    width: 56px;
    height: 56px;
    margin-left: 1%;
    flex-shrink: 0;
}

.brand-text {
    flex-direction: column;
    align-items: center;
    flex-shrink: 1;
}

.title-ja {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(255, 90, 140);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(255, 255, 255);
    text-shadow: 0 3px 0 rgb(60, 24, 44);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.title-en {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(70, 40, 30);
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
}

.spacer {
    flex-grow: 1;
    min-height: 2%;
    max-height: 8%;
}

.cta-button {
    width: 34%;
    min-width: 180px;
    max-width: 480px;
    height: 52px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 50, 110);
    background-color: rgb(52, 130, 235);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(30, 36, 60);
    margin: 0 0 1.5% 0;
    flex-shrink: 0;
}

.cta-button:hover {
    background-color: rgb(90, 160, 255);
}

.cta-button:active {
    background-color: rgb(36, 100, 200);
}

.cta-resume {
    background-color: rgb(70, 190, 100);
    -unity-text-outline-color: rgb(20, 70, 40);
    border-color: rgb(30, 80, 45);
}

.cta-resume:hover {
    background-color: rgb(90, 210, 120);
}

.cta-resume:active {
    background-color: rgb(50, 160, 80);
}

.tile-row {
    flex-direction: row;
    width: 92%;
    max-width: 1100px;
    height: 88px;
    justify-content: center;
    flex-shrink: 0;
}

.tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 100%;
    margin: 0 0.5%;
    padding: 6px;
    background-color: rgb(255, 252, 244);
    border-radius: 12px;
    border-width: 3px;
    align-items: center;
    justify-content: center;
}

.tile-pink {
    border-color: rgb(250, 170, 190);
}

.tile-yellow {
    border-color: rgb(240, 214, 140);
}

.tile-blue {
    border-color: rgb(150, 200, 240);
}

.tile:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 120, 150);
}

.tile.selected {
    background-color: rgb(255, 238, 176);
    border-color: rgb(40, 40, 48);
}

.tile-icon {
    width: 36%;
    height: 42%;
    min-width: 28px;
    max-width: 48px;
    min-height: 28px;
    max-height: 48px;
    margin-bottom: 2%;
}

.tile-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(40, 36, 48);
    white-space: normal;
    -unity-text-align: middle-center;
}

.destination-page {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 2% 3%;
    background-color: rgba(14, 18, 32, 0.97);
    flex-direction: column;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
}

.destination-page.hidden {
    display: none;
    opacity: 0;
    translate: 24px 0;
}

.destination-page.entering {
    opacity: 0;
    translate: 36px 0;
}

.menu-content.dimmed {
    opacity: 0;
    display: none;
}

.destination-chrome {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.destination-back {
    width: 110px;
    height: 36px;
    margin-right: 12px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgb(255, 252, 244);
    color: rgb(40, 36, 48);
    border-radius: 8px;
}

.destination-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.options-body {
    width: 48%;
    min-width: 280px;
    max-width: 520px;
}

.options-label {
    font-size: 14px;
    color: rgb(255, 220, 120);
    margin: 10px 0 4px 0;
}

.hidden {
    display: none;
}

.panel-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

.panel-body {
    font-size: 13px;
    color: rgb(220, 220, 230);
    white-space: normal;
    margin-bottom: 12px;
}

.panel-close {
    height: 36px;
    font-size: 15px;
    -unity-font-style: bold;
}

.collection-tabs {
    flex-direction: row;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.collection-tab {
    flex-grow: 1;
    height: 34px;
    margin-right: 6px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgb(40, 46, 64);
    color: rgb(230, 230, 240);
    border-width: 1px;
    border-color: rgb(80, 88, 110);
    border-radius: 8px;
}

.collection-tab.selected {
    background-color: rgb(255, 210, 80);
    color: rgb(30, 28, 36);
    border-color: rgb(40, 40, 48);
}

.collection-filters {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.collection-filter {
    height: 28px;
    margin: 0 4px 4px 0;
    padding: 0 8px;
    font-size: 12px;
    background-color: rgb(48, 54, 72);
    color: rgb(220, 220, 230);
    border-width: 1px;
    border-color: rgb(90, 96, 120);
    border-radius: 6px;
}

.collection-filter.selected {
    background-color: rgb(90, 160, 255);
    color: rgb(255, 255, 255);
    border-color: rgb(30, 60, 120);
}

.collection-strip-scroll {
    height: 210px;
    flex-shrink: 0;
    margin-bottom: 10px;
    background-color: rgba(8, 10, 18, 0.55);
    border-radius: 12px;
    padding: 8px;
}

.collection-strip {
    flex-direction: row;
    align-items: stretch;
    height: 100%;
}

.char-tile {
    width: 132px;
    height: 188px;
    margin-right: 10px;
    padding: 8px;
    flex-direction: column;
    align-items: center;
    background-color: rgb(255, 252, 244);
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(255, 170, 120);
}

.char-tile.selected {
    border-color: rgb(40, 40, 48);
    background-color: rgb(255, 232, 150);
}

.char-tile.locked {
    background-color: rgb(48, 52, 64);
    border-color: rgb(90, 96, 110);
}

.char-tile-art {
    width: 100%;
    height: 110px;
    margin-bottom: 6px;
    background-color: rgb(210, 216, 230);
    border-radius: 8px;
}

.char-tile.locked .char-tile-art {
    background-color: rgb(28, 30, 40);
}

.char-tile-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(32, 30, 40);
    white-space: normal;
    -unity-text-align: middle-center;
}

.char-tile.locked .char-tile-name {
    color: rgb(200, 200, 210);
}

.char-tile-arch {
    font-size: 11px;
    color: rgb(90, 80, 70);
    margin-top: 2px;
}

.char-tile.locked .char-tile-arch {
    color: rgb(160, 160, 170);
}

.card-tile {
    width: 120px;
    height: 160px;
    margin-right: 8px;
    padding: 10px;
    flex-direction: column;
    justify-content: space-between;
    background-color: rgb(255, 252, 244);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(150, 190, 230);
}

.card-tile.signature {
    border-color: rgb(255, 120, 160);
    background-color: rgb(255, 236, 210);
}

.card-tile-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(32, 30, 40);
    white-space: normal;
}

.card-tile-cost {
    font-size: 12px;
    color: rgb(70, 90, 140);
}

.collection-feature {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.collection-portrait {
    width: 28%;
    min-width: 180px;
    max-width: 280px;
    margin-right: 14px;
    background-color: rgba(10, 12, 20, 0.45);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 200, 64);
}

.collection-portrait.locked {
    background-color: rgb(24, 26, 34);
    border-color: rgb(80, 84, 96);
}

.collection-detail {
    flex-grow: 1;
    background-color: rgba(10, 12, 20, 0.35);
    border-radius: 8px;
    padding: 12px;
}

.collection-detail-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 4px;
    white-space: normal;
}

.collection-detail-unlock {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(120, 210, 255);
    margin-bottom: 8px;
    white-space: normal;
}

.collection-detail-meta {
    font-size: 13px;
    color: rgb(255, 220, 120);
    white-space: normal;
    margin-bottom: 10px;
}

.collection-detail-body {
    font-size: 14px;
    color: rgb(220, 220, 230);
    white-space: normal;
}

.collection-empty {
    color: rgb(180, 180, 190);
    font-size: 13px;
    margin: 8px;
}

.collection-list {
    width: 42%;
    margin-right: 10px;
    background-color: rgba(10, 12, 20, 0.35);
    border-radius: 8px;
    padding: 4px;
}

.collection-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.deck-seats {
    flex-direction: row;
    margin-bottom: 6px;
}

.deck-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    min-width: 0;
}

.deck-column-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 220, 120);
    margin-bottom: 4px;
}

.deck-list {
    width: auto;
    flex-grow: 1;
    margin-right: 0;
}

.deck-item {
    height: 32px;
    margin: 0 0 4px 0;
    padding: 0 8px;
    font-size: 12px;
    -unity-text-align: middle-left;
    background-color: rgb(255, 252, 244);
    color: rgb(32, 30, 40);
    border-width: 1px;
    border-color: rgb(200, 190, 170);
    border-radius: 6px;
}

.deck-item.selected {
    background-color: rgb(255, 230, 140);
    border-color: rgb(40, 40, 48);
}
