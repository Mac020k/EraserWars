<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:Label name="phase" text="Phase" style="font-size: 28px; -unity-font-style: bold; margin: 12px;" />
        <ui:Label name="stocks" text="Stocks" style="font-size: 20px; margin-left: 12px;" />
        <ui:VisualElement style="position: absolute; bottom: 16px; left: 16px; flex-direction: row;">
            <ui:Button name="pass" text="パス" style="width: 120px; height: 48px; font-size: 22px;" />
            <ui:Button name="rematch" text="再戦" style="width: 120px; height: 48px; font-size: 22px; margin-left: 8px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
