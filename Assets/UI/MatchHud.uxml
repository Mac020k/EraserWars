<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="MatchHud.uss" />
    <ui:VisualElement name="root" class="hud-root hidden" picking-mode="Ignore">
        <ui:VisualElement name="hand-dock" class="hand-dock hidden" picking-mode="Ignore">
            <ui:Label name="hand-title" text="" class="hand-title" picking-mode="Ignore" />
            <ui:VisualElement name="hand" class="hand-row" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="score-rail" class="score-rail" picking-mode="Ignore">
            <ui:VisualElement name="score-rail-line" class="score-rail-line" picking-mode="Ignore" />
            <ui:VisualElement name="players" class="players-row" picking-mode="Ignore" />
            <ui:VisualElement name="turn-callout" class="turn-callout" picking-mode="Ignore">
                <ui:VisualElement name="timer-ring" class="timer-ring" picking-mode="Ignore" />
                <ui:VisualElement name="timer-box" class="timer-box" picking-mode="Ignore">
                    <ui:Label name="phase" text="Round1" class="hud-round" picking-mode="Ignore" />
                    <ui:VisualElement class="timer-row" picking-mode="Ignore">
                        <ui:Label name="timer" text="--" class="hud-timer" picking-mode="Ignore" />
                        <ui:Label name="timer-unit" text="秒" class="timer-unit" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="turn" text="" class="hud-turn" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="turn-yield" text="" class="turn-yield hidden" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="pass-hint" text="" class="pass-hint hidden" picking-mode="Ignore" />
        <ui:Button name="menu" class="hud-menu-button">
            <ui:Label name="menu-label" text="メニュー" class="hud-menu-label" picking-mode="Ignore" />
        </ui:Button>
        <ui:Button name="pass" class="action-chip action-pass">
            <ui:VisualElement name="pass-icon" class="action-icon" picking-mode="Ignore" />
            <ui:Label name="pass-label" text="パス" class="action-label" picking-mode="Ignore" />
            <ui:Label text="▶▶" class="pass-marks" picking-mode="Ignore" />
        </ui:Button>
        <ui:VisualElement name="match-end" class="match-end hidden" picking-mode="Ignore">
            <ui:VisualElement name="match-end-dim" class="match-end-dim" picking-mode="Ignore" />
            <ui:VisualElement name="match-end-card" class="match-end-card">
                <ui:VisualElement name="result-seat-bar" class="result-seat-bar" picking-mode="Ignore" />
                <ui:Label name="result-kicker" text="しょうぶあり" class="result-kicker" picking-mode="Ignore" />
                <ui:Label name="result-text" text="" class="result-text" picking-mode="Ignore" />
                <ui:Label name="result-summary" text="" class="result-summary" picking-mode="Ignore" />
                <ui:Label name="result-xp" text="" class="result-xp" picking-mode="Ignore" />
                <ui:VisualElement class="match-end-actions">
                    <ui:Button name="rematch" text="再戦" class="match-end-button match-end-primary" />
                    <ui:Button name="match-end-menu" text="メニューへ" class="match-end-button match-end-secondary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="turn-announce" class="turn-announce hidden" picking-mode="Ignore">
            <ui:Label name="turn-announce-line" text="" class="turn-announce-line" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="card-cutin" class="card-cutin hidden" picking-mode="Ignore">
            <ui:VisualElement name="card-cutin-dim" class="card-cutin-dim" picking-mode="Ignore" />
            <ui:VisualElement name="card-cutin-banner" class="card-cutin-banner" picking-mode="Ignore">
                <ui:VisualElement name="card-cutin-face" class="card-cutin-face" picking-mode="Ignore" />
                <ui:VisualElement class="card-cutin-copy" picking-mode="Ignore">
                    <ui:Label name="card-cutin-kicker" text="" class="card-cutin-kicker" picking-mode="Ignore" />
                    <ui:Label name="card-cutin-name" text="" class="card-cutin-name" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-overlay" class="pause-overlay hidden">
            <ui:VisualElement name="pause-dim" class="pause-dim" />
            <ui:VisualElement name="pause-card" class="pause-card">
                <ui:Label name="pause-title" text="ポーズ" class="pause-title" />
                <ui:Label name="pause-rules" text="" class="pause-copy" />
                <ui:Label name="pause-seats" text="" class="pause-seats" />
                <ui:Label name="pause-options" text="" class="pause-copy pause-options" />
                <ui:VisualElement class="pause-actions">
                    <ui:Button name="pause-continue" class="pause-button pause-continue">
                        <ui:Label name="pause-continue-label" text="つづける" class="pause-button-label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="pause-main" class="pause-button pause-main">
                        <ui:Label name="pause-main-label" text="メインメニューへ" class="pause-button-label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
