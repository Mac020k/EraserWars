.card-face {
    position: relative;
    overflow: hidden;
    padding: 0;
    border-width: 3px;
    border-color: rgb(28, 16, 14);
    border-radius: 14px;
    flex-direction: column;
    align-items: stretch;
    transition-property: scale, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.card-face-pattern {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 42px;
    overflow: hidden;
    border-radius: 7px;
}

.card-face-mat {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 42px;
    border-width: 3px;
    border-radius: 7px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
}

.cutin-card .card-face-pattern,
.cutin-card .card-face-mat {
    bottom: 6px;
}

.card-cost-gem {
    position: absolute;
    top: 0;
    left: 0;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(12, 10, 10);
    align-items: center;
    justify-content: center;
}

.card-cost-value {
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.card-effect-icon {
    position: absolute;
    top: 28px;
    left: 22px;
    width: 72px;
    height: 72px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.hand-card .card-effect-icon {
    top: 20px;
    left: 19px;
    width: 68px;
    height: 68px;
}

.card-tile .card-effect-icon {
    top: 24px;
    left: 21px;
    width: 72px;
    height: 72px;
}

.card-ribbon {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 96px;
    height: 16px;
    margin: 0;
    padding: 0 4px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(42, 28, 8);
    background-color: rgb(232, 184, 72);
    border-radius: 6px;
}

.hand-card .card-ribbon {
    top: 92px;
}

.card-tile .card-ribbon {
    top: 102px;
}

.card-face-body {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 6px;
    height: 32px;
    margin: 0;
    padding: 0 2px;
    background-color: rgb(255, 255, 255);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
}

.card-face-name {
    margin: 0;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: rgb(28, 16, 12);
}

.card-face.family-kiai {
    background-color: rgb(214, 24, 40);
}

.card-face.family-homework {
    background-color: rgb(12, 92, 214);
}

.card-face.family-seat {
    background-color: rgb(8, 150, 64);
}

.card-face.family-stationery {
    background-color: rgb(230, 128, 8);
}

.card-face.family-cover {
    background-color: rgb(214, 32, 104);
}

.card-face.family-signature {
    background-color: rgb(232, 184, 72);
}

.card-face.family-unknown {
    background-color: rgb(64, 64, 72);
}

.card-face.signature .card-face-mat {
    border-color: rgb(255, 220, 140);
}

.card-face.signature .card-cost-gem {
    background-color: rgb(232, 184, 72);
    border-color: rgb(255, 248, 220);
}

.card-face.signature .card-cost-value {
    color: rgb(28, 22, 12);
}

.card-face.signature .card-face-body {
    background-color: rgb(255, 232, 170);
}
